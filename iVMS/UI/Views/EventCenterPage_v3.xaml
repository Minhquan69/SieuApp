                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Confidence}" Foreground="#35D07F" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ẢNH" Width="108">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="8,5" Width="76" Height="52" Background="{StaticResource VmsSurface2Brush_v3}" CornerRadius="6" ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Empty state -->
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" Visibility="Collapsed">
                                <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource VmsSurface2Brush_v3}" HorizontalAlignment="Center">
                                    <Path Data="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z" Fill="{StaticResource VmsTextDisabledBrush_v3}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="EmptyStateTitle" Text="Không tìm thấy phương tiện" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock x:Name="EmptyStateDetail" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12" TextWrapping="Wrap" MaxWidth="280" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="3" Padding="12,8" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PageInfoText" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="PageSizeCombo" Tag="NoSearch" Style="{StaticResource FilterCB}" Width="95" Margin="0,0,10,0" SelectionChanged="PageSize_SelectionChanged">
                                    <ComboBoxItem Content="8 / trang"  Tag="8"/>
                                    <ComboBoxItem Content="10 / trang" Tag="10" IsSelected="True"/>
                                    <ComboBoxItem Content="20 / trang" Tag="20"/>
                                    <ComboBoxItem Content="50 / trang" Tag="50"/>
                                </ComboBox>
                                <Button x:Name="PrevBtn" Style="{StaticResource NavBtn}" Content="‹" Click="PrevPage_Click"/>
                                <TextBlock x:Name="PageLabel" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12" VerticalAlignment="Center" Margin="8,0"/>
                                <Button x:Name="NextBtn" Style="{StaticResource NavBtn}" Content="›" Click="NextPage_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── RIGHT: detail panel ─── -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="20" x:Name="DetailPanel"
                    Style="{StaticResource PanelCard}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Padding="16,12"
                            BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CHI TIẾT"
                                           Foreground="{StaticResource VmsPrimaryBrush_v3}"
                                           FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="DetailTitle" Text="—"
                                           Foreground="{StaticResource VmsTextPrimaryBrush_v3}"
                                           FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource CloseBtn}"
                                    Content="✕" Click="CloseDetail_Click"/>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <Grid Grid.Row="1" Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="620"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="284"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1" CornerRadius="7" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="DANH SÁCH PHƯƠNG TIỆN" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontWeight="SemiBold" FontSize="11" Margin="6,4,6,10"/>
                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <Grid><TextBox x:Name="DetailSearchBox" Style="{StaticResource SearchTB}" TextChanged="DetailSearch_TextChanged"/><Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="{StaticResource VmsTextTertiaryBrush_v3}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/><TextBlock x:Name="DetailSearchPlaceholder" Text="Tìm biển số, camera..." Foreground="{StaticResource VmsTextDisabledBrush_v3}" FontSize="12" VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="DetailCameraCombo" Style="{StaticResource FilterCB}" IsTextSearchEnabled="True" SelectedIndex="0" SelectionChanged="DetailCamera_SelectionChanged"><ComboBoxItem Content="Tất cả camera" Tag="all"/></ComboBox><ComboBox Grid.Column="2" Style="{StaticResource FilterCB}" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="Tất cả công đoạn"/></ComboBox></Grid>
                                </StackPanel>
                                <ListBox x:Name="DetailList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="DetailList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Visible">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="7" Margin="0,0,0,4" CornerRadius="5" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Camera}" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="10" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding TimeIn}" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="10" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding TimeOnly}" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="{Binding DateOnly}" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="9" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
                                                    <Border Grid.Column="2" Width="44" Height="34" CornerRadius="4" ClipToBounds="True" Background="{StaticResource VmsSurface3Brush_v3}" HorizontalAlignment="Right">
                                                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1D3D76C5"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource VmsSurface3Brush_v3}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,8,4,0"><Button Style="{StaticResource NavBtn}" Content="‹" Click="DetailPrevPage_Click"/><TextBlock x:Name="DetailPageLabel" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="11" VerticalAlignment="Center" Margin="7,0"/><Button Style="{StaticResource NavBtn}" Content="›" Click="DetailNextPage_Click"/></StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <!-- Image preview -->
                            <Border Background="{StaticResource VmsSurface2Brush_v3}" Visibility="Collapsed"
                                    CornerRadius="6" Height="180" ClipToBounds="True"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="UniformToFill"/>
                                    <StackPanel x:Name="PreviewPlaceholder"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                              Fill="{StaticResource VmsTextDisabledBrush_v3}"
                                              Width="28" Height="28" Stretch="Uniform"
                                              HorizontalAlignment="Center"/>
                                        <TextBlock Text="Chưa có ảnh"
                                                   Foreground="{StaticResource VmsTextDisabledBrush_v3}"
                                                   FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="DetailPlaybackPanel" Background="{StaticResource VmsSurface2Brush_v3}"
                                    BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                                    BorderThickness="1" CornerRadius="6" Height="465" ClipToBounds="True"
                                    SizeChanged="DetailPlaybackPanel_SizeChanged">
                                <Grid>
                                    <Frame x:Name="DetailPlaybackHost" NavigationUIVisibility="Hidden"/>
                                    <TextBlock x:Name="DetailVideoPlaceholder" Text="Đang chuẩn bị playback..." Foreground="{StaticResource VmsTextDisabledBrush_v3}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- Info card -->
                            <Border Background="{StaticResource VmsSurface2Brush_v3}"
                                    BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Thông tin phiên ghi nhận"
                                               Foreground="{StaticResource VmsTextSecondaryBrush_v3}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Biển số"    Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/>
                                        <TextBlock x:Name="DTitle"   Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Camera"     Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/>
                                        <TextBlock x:Name="DCamera"  Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Công đoạn"  Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/>
                                        <TextBlock x:Name="DRoi"     Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Bắt đầu"    Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/>
                                        <TextBlock x:Name="DTimeIn"  Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Kết thúc"   Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/>
                                        <TextBlock x:Name="DTimeOut" Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="12"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Thời gian"  Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/>
                                        <TextBlock x:Name="DDuration" Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource VmsSurface2Brush_v3}"
                                    BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="ẢNH CHỤP BIỂN SỐ" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
                                    <Border Height="210" CornerRadius="5" ClipToBounds="True" Background="{StaticResource VmsSurface3Brush_v3}">
                                        <Image x:Name="DetailImage" Stretch="UniformToFill"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Metadata card -->
                            <Border Background="{StaticResource VmsSurface2Brush_v3}" Visibility="Collapsed"
                                    BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="Metadata"
                                               Foreground="{StaticResource VmsTextSecondaryBrush_v3}"
                                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Object key"  Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="11"/>
                                        <TextBlock x:Name="DDetId"    Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Asset ID"    Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="11"/>
                                        <TextBlock x:Name="DAssetId"  Grid.Column="1" Text="—" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="11" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- In-app overlay for Recorded tab detail. It never creates a native popup window. -->
        <Border x:Name="RecordedDetailPanel" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100"
                Visibility="Collapsed" Background="#B8000918"
                MouseLeftButtonDown="RecordedDetailBackdrop_MouseLeftButtonDown">
            <Grid>
                <Border Width="560" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="{StaticResource VmsSurfaceBrush_v3}"
                        BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1,0,0,0"
                        ClipToBounds="True"
                        MouseLeftButtonDown="RecordedDetailContent_MouseLeftButtonDown">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="24,20,24,16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#102C59" VerticalAlignment="Center">
                                    <TextBlock Text="◉" Foreground="{StaticResource VmsPrimaryBrush_v3}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="AI EVENT" Foreground="{StaticResource VmsPrimaryBrush_v3}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="RecordedDetailTitle" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource CloseBtn}" Content="✕" Click="CloseRecordedDetail_Click"/>
                            </Grid>
                            <Border Height="416" Background="{StaticResource VmsSurface3Brush_v3}" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="RecordedDetailImage" Stretch="UniformToFill"/>
                                    <TextBlock x:Name="RecordedDetailImagePlaceholder" Text="Chưa có ảnh chụp" Foreground="{StaticResource VmsTextDisabledBrush_v3}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Grid Margin="16,26,16,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="12"/><RowDefinition Height="96"/><RowDefinition Height="12"/><RowDefinition Height="86"/></Grid.RowDefinitions>
                                <Border Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Đối tượng" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/><TextBlock x:Name="RecordedDetailObject" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="15" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Biển số" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/><TextBlock x:Name="RecordedDetailPlate" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="15" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Grid.Row="2" Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Camera" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/><TextBlock x:Name="RecordedDetailCamera" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="15" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Độ tin cậy" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/><TextBlock x:Name="RecordedDetailConfidence" Text="—" Foreground="#35D07F" FontWeight="SemiBold" FontSize="15" Margin="0,7,0,0"/><ProgressBar x:Name="RecordedDetailConfidenceBar" Height="6" Maximum="100" Margin="0,8,0,0" Foreground="{StaticResource VmsPrimaryBrush_v3}"/></StackPanel></Border>
                                <Border Grid.Row="4" Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}" BorderThickness="1" CornerRadius="12" Padding="16"><StackPanel><TextBlock Text="Thời gian" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="12"/><TextBlock x:Name="RecordedDetailTime" Text="—" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="15" Margin="0,7,0,0"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
