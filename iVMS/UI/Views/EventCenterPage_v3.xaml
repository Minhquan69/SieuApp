                            <ComboBox x:Name="ProcessCombo" Grid.Column="2" Style="{StaticResource FilterCB}" Width="145" Margin="8,0,0,0"
                                      IsEnabled="False" Opacity="0.45" ToolTip="Bộ lọc công đoạn hiện không khả dụng"
                                      SelectionChanged="ProcessCombo_SelectionChanged">
                                <ComboBoxItem Content="Tất cả công đoạn" Tag="all" IsSelected="True"/>
                            </ComboBox>

