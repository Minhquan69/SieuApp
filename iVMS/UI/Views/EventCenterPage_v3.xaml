<UserControl x:Class="V3SClient.UI.Views.EventCenterPage_v3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource VmsBackgroundBrush_v3}"><UserControl.Resources><Style x:Key="VmsPanelBorder_v3" TargetType="Border"><Setter Property="Background" Value="{StaticResource VmsElevatedBrush_v3}"/><Setter Property="BorderBrush" Value="{StaticResource VmsBorderStrongBrush_v3}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style></UserControl.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AI MONITORING" Foreground="{StaticResource VmsPrimaryBrush_v3}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Trung tâm sự kiện AI" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Theo dõi các sự kiện phát hiện bởi AI" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="Làm mới" Click="Refresh_Click" Padding="14,7" VerticalAlignment="Center"/></Grid>
<Border Grid.Row="1" Style="{StaticResource VmsPanelBorder_v3}" Padding="10" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Từ khóa" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="SearchBox" Width="220" TextChanged="Search_TextChanged"/><TextBlock x:Name="CountText" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource VmsPanelBorder_v3}" Margin="0,0,12,0"><DataGrid x:Name="EventsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="Event_Selected" Background="Transparent" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Thời gian" Binding="{Binding Time}" Width="150"/><DataGridTextColumn Header="Camera" Binding="{Binding Camera}" Width="120"/><DataGridTextColumn Header="Đối tượng" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="140"/><DataGridTextColumn Header="Tin cậy" Binding="{Binding Confidence}" Width="80"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Style="{StaticResource VmsPanelBorder_v3}" Padding="18"><StackPanel><TextBlock Text="Chi tiết sự kiện" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="16" FontWeight="SemiBold"/><Image x:Name="PreviewImage" Height="180" Stretch="UniformToFill" Margin="0,16,0,12"/><TextBlock x:Name="DetailTitle" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="DetailText" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></Grid>
</Grid></UserControl>
