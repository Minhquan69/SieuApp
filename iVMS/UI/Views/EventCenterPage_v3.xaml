        <Grid Grid.Row="2" Margin="20,12,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="DetailCol" Width="0"/>
