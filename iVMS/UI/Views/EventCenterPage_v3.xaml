<UserControl x:Class="V3SClient.UI.Views.EventCenterPage_v3" x:Name="EventCenterRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="{StaticResource VmsBackgroundBrush_v3}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Panel card -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource VmsSurfaceBrush_v3}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource VmsBorderBrush_v3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <!-- Pill / secondary button -->
        <Style x:Key="PillBtn" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource VmsSurface2Brush_v3}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource VmsBorderBrush_v3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource VmsTextSecondaryBrush_v3}"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="MinHeight"       Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="R" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="R" Property="Background" Value="{StaticResource VmsSurface3Brush_v3}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"   Value="True">
                                <Setter TargetName="R" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"   Value="False">
                                <Setter TargetName="R" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-only square -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Width"   Value="32"/>
            <Setter Property="Height"  Value="32"/>
        </Style>

        <Style x:Key="RefreshIconBtn" TargetType="Button" BasedOn="{StaticResource VmsRefreshButtonStyle_v3}"/>

        <!-- Primary blue button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Background"  Value="{StaticResource VmsPrimaryBrush_v3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VmsPrimaryBrush_v3}"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
        </Style>

        <!-- Tab button -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource VmsTextSecondaryBrush_v3}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Active underline -->
                            <Border x:Name="Line" Height="2"
                                    Background="{StaticResource VmsPrimaryBrush_v3}"
                                    VerticalAlignment="Bottom" CornerRadius="1,1,0,0"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{StaticResource VmsSurface2Brush_v3}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search TextBox -->
        <Style x:Key="SearchTB" TargetType="TextBox">
            <Setter Property="Background"              Value="{StaticResource VmsSurface2Brush_v3}"/>
            <Setter Property="BorderBrush"             Value="{StaticResource VmsBorderBrush_v3}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Foreground"              Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="CaretBrush"              Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="Height"                  Value="32"/>
            <Setter Property="Padding"                 Value="32,0,9,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="R" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="R" Property="BorderBrush"
                                        Value="{StaticResource VmsFocusBrush_v3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="FilterCB" TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource VmsSurface2Brush_v3}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource VmsBorderBrush_v3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="{StaticResource VmsTextSecondaryBrush_v3}"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bdr" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid Margin="10,0,28,0">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                </Grid>
                            </Border>
                            <!-- Arrow -->
                            <Path Data="M 0 0 L 7 0 L 3.5 4 Z"
                                  Fill="{StaticResource VmsTextTertiaryBrush_v3}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <ToggleButton HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                          Opacity="0" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False"
                                   IsOpen="{Binding IsDropDownOpen,
                                       RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True">
                                <Border MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{StaticResource VmsElevatedBrush_v3}"
                                        BorderBrush="{StaticResource VmsBorderStrongBrush_v3}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                                    <StackPanel>
                                        <Grid x:Name="DropSearchArea" Margin="6,6,6,3">
                                            <Border Background="{StaticResource VmsSurfaceBrush_v3}"
                                                    BorderBrush="{StaticResource VmsBorderBrush_v3}" BorderThickness="1"
                                                    CornerRadius="5" Height="30"/>
                                            <Path Data="M15.5,14 L14.7,14 L14.4,13.7 C15.4,12.6 16,11.1 16,9.5 C16,5.9 13.1,3 9.5,3 C5.9,3 3,5.9 3,9.5 C3,13.1 5.9,16 9.5,16 C11.1,16 12.6,15.4 13.7,14.4 L14,14.7 L14,15.5 L19,20.5 L20.5,19 Z M9.5,14 C7,14 5,12 5,9.5 C5,7 7,5 9.5,5 C12,5 14,7 14,9.5 C14,12 12,14 9.5,14 Z"
                                                  Fill="{StaticResource VmsTextTertiaryBrush_v3}" Width="13" Height="13"
                                                  Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="14,0,0,0" IsHitTestVisible="False"/>
                                            <TextBox x:Name="DropSearchBox" Height="30" Padding="32,0,8,0"
                                                     VerticalContentAlignment="Center" Background="Transparent"
                                                     BorderThickness="0" Foreground="{StaticResource VmsTextPrimaryBrush_v3}"
                                                     CaretBrush="{StaticResource VmsTextPrimaryBrush_v3}"
                                                     TextChanged="CameraDropdownSearch_TextChanged" ToolTip="Tìm camera"/>
                                            <TextBlock x:Name="DropSearchHint" Text="Tìm camera…" Margin="34,0,8,0" VerticalAlignment="Center"
                                                       Foreground="{StaticResource VmsTextDisabledBrush_v3}" FontSize="12"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                        <ScrollViewer MaxHeight="240">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="NoSearch">
                                <Setter TargetName="DropSearchArea" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bdr" Property="BorderBrush"
                                        Value="{StaticResource VmsBorderStrongBrush_v3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground"  Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background"
                                        Value="{StaticResource VmsSurface3Brush_v3}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="B" Property="Background"
                                        Value="{StaticResource VmsPrimarySoftBrush_v3}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource VmsFocusBrush_v3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination nav button -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource PillBtn}">
            <Setter Property="Width"   Value="28"/>
            <Setter Property="Height"  Value="28"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- DataGrid column header -->
        <Style x:Key="DgHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{StaticResource VmsSurface2Brush_v3}"/>
            <Setter Property="Foreground"      Value="{StaticResource VmsTextSecondaryBrush_v3}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource VmsBorderSubtleBrush_v3}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="12,9"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>

        <!-- DataGrid row -->
        <Style x:Key="DgRow" TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource VmsBorderSubtleBrush_v3}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight"       Value="58"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VmsSurface2Brush_v3}"/>
                </Trigger>
                <Trigger Property="IsSelected"  Value="True">
                    <Setter Property="Background" Value="{StaticResource VmsPrimarySoftBrush_v3}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Calendar styles for DatePicker popup -->
        <Style x:Key="PlaybackCalendarDay_v3" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Margin="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource VmsPrimaryBrush_v3}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource VmsPrimarySoftBrush_v3}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaybackCalendarDayButton_v3" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource VmsPrimarySoftBrush_v3}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource VmsPrimaryBrush_v3}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>


        <!-- Close X button -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{StaticResource VmsTextTertiaryBrush_v3}"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="R" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="R" Property="Background"
                                        Value="{StaticResource VmsSurface3Brush_v3}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header  -->
            <RowDefinition Height="Auto"/>   <!-- KPI row -->
            <RowDefinition Height="*"/>      <!-- content -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             HEADER
             ══════════════════════════════════════════════════════ -->
        <Border Background="{StaticResource VmsSidebarBrush_v3}"
                BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                BorderThickness="0,0,0,1" Padding="20,10,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title -->
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Giám sát phương tiện"
                               Foreground="{StaticResource VmsTextPrimaryBrush_v3}"
                               FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Right: controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Calendar filter Custom Dropdown -->
                    <Grid>
                        <ToggleButton x:Name="DateFilterToggle" Click="DateFilterToggle_Click" Cursor="Hand" Width="137" Height="32" Background="{StaticResource VmsSurface2Brush_v3}" BorderBrush="{StaticResource VmsBorderBrush_v3}" BorderThickness="1" Padding="0,0,10,0">
                             <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                 <Border Width="32" Height="32" CornerRadius="5,0,0,5" Background="Transparent">
                                     <Path Data="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z" Fill="{StaticResource VmsTextTertiaryBrush_v3}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                 </Border>
                                 <TextBlock x:Name="DateFilterText" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" VerticalAlignment="Center" FontSize="12"/>
                             </StackPanel>
                             <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                         <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource VmsBorderStrongBrush_v3}"/></Trigger>
                                        <Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{StaticResource VmsBorderStrongBrush_v3}"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                             </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="DateFilterPopup" PlacementTarget="{Binding ElementName=DateFilterToggle}" Placement="Bottom" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=DateFilterToggle}">
                            <Border Width="260" Background="{StaticResource VmsElevatedBrush_v3}" BorderBrush="{StaticResource VmsBorderStrongBrush_v3}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                         <TextBlock Text="NGÀY" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" FontSize="10" FontWeight="SemiBold"/>
                                    </Grid>
                                    <Border Height="34" CornerRadius="4" BorderBrush="{StaticResource VmsPrimaryBrush_v3}" BorderThickness="1" Background="{StaticResource VmsSurfaceBrush_v3}" Margin="0,0,0,12">
                                         <TextBlock x:Name="PopupDateInputText" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="9,0" FontSize="12"/>
                                    </Border>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                        <Button Grid.Row="0" Grid.Column="0" Content="‹" Click="PreviousMonth_Click" FontSize="23" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" Background="Transparent" BorderThickness="0" ToolTip="Tháng trước">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <TextBlock x:Name="calendarMonthText" Grid.Row="0" Grid.Column="1" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource VmsTextPrimaryBrush_v3}"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="›" Click="NextMonth_Click" FontSize="23" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" Background="Transparent" BorderThickness="0" ToolTip="Tháng sau">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                        </Button>
                                        <primitives:UniformGrid Grid.Row="1" Grid.ColumnSpan="3" Columns="7">
                                            <TextBlock Text="Su" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/><TextBlock Text="Mo" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/><TextBlock Text="Tu" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/><TextBlock Text="We" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/><TextBlock Text="Th" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/><TextBlock Text="Fr" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/><TextBlock Text="Sa" TextAlignment="Center" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/>
                                        </primitives:UniformGrid>
                                        <primitives:UniformGrid x:Name="calendarDaysPanel" Grid.Row="2" Grid.ColumnSpan="3" Columns="7"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Camera filter multi-select -->
                    <Grid Margin="8,0,0,0">
                        <ToggleButton x:Name="CameraFilterToggle"
                                      Width="155" Height="32"
                                      Background="{StaticResource VmsSurface2Brush_v3}"
                                      BorderBrush="{StaticResource VmsBorderBrush_v3}"
                                      BorderThickness="1" Cursor="Hand" Padding="12,0,10,0">
                            <!-- Direct content instead of template content -->
                            <Grid Width="131">
                                <TextBlock x:Name="CameraToggleText" Text="Tất cả camera"
                                           Foreground="{StaticResource VmsTextPrimaryBrush_v3}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           FontSize="12"/>
                                <Path Data="M 0 0 L 7 0 L 3.5 4 Z"
                                      Fill="{StaticResource VmsTextTertiaryBrush_v3}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource VmsBorderStrongBrush_v3}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource VmsBorderStrongBrush_v3}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="CameraFilterPopup"
                               PlacementTarget="{Binding ElementName=CameraFilterToggle}"
                               Placement="Bottom" StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=CameraFilterToggle}">
                            <Border Background="{StaticResource VmsElevatedBrush_v3}"
                                    BorderBrush="{StaticResource VmsBorderStrongBrush_v3}"
                                    BorderThickness="1" CornerRadius="8"
                                    Width="260" Margin="0,4,0,0" Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="Chọn camera" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="CameraSelectedCountText" Text="0/0" HorizontalAlignment="Right" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="12"/>
                                    </Grid>

                                    <!-- Search -->
                                    <Grid Grid.Row="1" Margin="0,0,0,12">
                                        <TextBox x:Name="CameraSearchBox" Style="{StaticResource SearchTB}" TextChanged="CameraSearchBox_TextChanged"/>
                                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                              Fill="{StaticResource VmsTextTertiaryBrush_v3}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="10,0,0,0" IsHitTestVisible="False"/>
