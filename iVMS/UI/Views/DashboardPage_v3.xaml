              </Grid.RowDefinitions>
              <Border BorderBrush="#FF193A56" BorderThickness="0,0,0,1" Padding="12,7">
                <StackPanel>
                  <TextBlock Text="Sức khỏe hạ tầng" Style="{StaticResource PanelTitle}">
                  </TextBlock>
                  <TextBlock Text="Tổng hợp máy chủ và tài nguyên hệ thống" Foreground="#FFB7CDE0" FontSize="10" Margin="0,3,0,0">
                  </TextBlock>
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.05*">
                  </ColumnDefinition>
                  <ColumnDefinition Width="1.15*">
                  </ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <Grid>
                    <TextBlock Text="MÁY CHỦ" Foreground="#FF8EA7BC" FontSize="9">
                    </TextBlock>
                    <TextBlock Text="1/1" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right">
                    </TextBlock>
                  </Grid>
                  <TextBlock Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,13,0,4">
                    <TextBlock.Text>
                      <Binding Path="Text" ElementName="InfrastructureHostText"/>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock FontSize="10" FontWeight="SemiBold">
                    <TextBlock.Text>
                      <Binding Path="Text" ElementName="InfrastructureStatusText"/>
                    </TextBlock.Text>
                    <TextBlock.Foreground>
                      <Binding Path="Foreground" ElementName="InfrastructureStatusText"/>
                    </TextBlock.Foreground>
                  </TextBlock>
                </StackPanel>
                <Grid Grid.Column="1">
                  <Grid.RowDefinitions>
                    <RowDefinition>
                    </RowDefinition>
                    <RowDefinition>
                    </RowDefinition>
                    <RowDefinition>
                    </RowDefinition>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58">
                    </ColumnDefinition>
                    <ColumnDefinition Width="*">
                    </ColumnDefinition>
                    <ColumnDefinition Width="42">
                    </ColumnDefinition>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="CPU" Foreground="#FFD5E3EE" FontSize="10" VerticalAlignment="Center">
                  </TextBlock>
                  <ProgressBar Grid.Column="1" Maximum="100" Height="6" Background="#FF294157" Foreground="#FF367BFF" VerticalAlignment="Center" Margin="5,0">
                    <RangeBase.Value>
                      <Binding Path="Value" ElementName="InfrastructureCpuBar"/>
                    </RangeBase.Value>
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Panel.Background}" CornerRadius="3">
                          <Border x:Name="PART_Indicator" Background="{TemplateBinding TextElement.Foreground}" HorizontalAlignment="Left" CornerRadius="3">
                          </Border>
                        </Border>
                      </ControlTemplate>
                    </Control.Template>
                  </ProgressBar>
                  <TextBlock Grid.Column="2" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <Binding Path="Text" ElementName="InfrastructureCpuText"/>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Row="1" Text="Bộ nhớ" Foreground="#FFD5E3EE" FontSize="10" VerticalAlignment="Center">
                  </TextBlock>
                  <ProgressBar Grid.Row="1" Grid.Column="1" Maximum="100" Height="6" Background="#FF294157" Foreground="#FF27C96D" VerticalAlignment="Center" Margin="5,0">
                    <RangeBase.Value>
                      <Binding Path="Value" ElementName="InfrastructureMemoryBar"/>
                    </RangeBase.Value>
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Panel.Background}" CornerRadius="3">
                          <Border x:Name="PART_Indicator" Background="{TemplateBinding TextElement.Foreground}" HorizontalAlignment="Left" CornerRadius="3">
                          </Border>
                        </Border>
                      </ControlTemplate>
                    </Control.Template>
                  </ProgressBar>
                  <TextBlock Grid.Row="1" Grid.Column="2" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <Binding Path="Text" ElementName="InfrastructureMemoryText"/>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Row="2" Text="GPU" Foreground="#FFD5E3EE" FontSize="10" VerticalAlignment="Center">
                  </TextBlock>
                  <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="100" Height="6" Background="#FF294157" Foreground="#FFA66CFF" VerticalAlignment="Center" Margin="5,0">
                    <RangeBase.Value>
                      <Binding Path="Value" ElementName="InfrastructureGpuBar"/>
                    </RangeBase.Value>
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Panel.Background}" CornerRadius="3">
                          <Border x:Name="PART_Indicator" Background="{TemplateBinding TextElement.Foreground}" HorizontalAlignment="Left" CornerRadius="3">
                          </Border>
                        </Border>
                      </ControlTemplate>
                    </Control.Template>
                  </ProgressBar>
                  <TextBlock Grid.Row="2" Grid.Column="2" Foreground="#FFFFFFFF" FontSize="10" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <Binding Path="Text" ElementName="InfrastructureGpuText"/>
                    </TextBlock.Text>
                  </TextBlock>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,6,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="56">
                </RowDefinition>
                <RowDefinition Height="*">
                </RowDefinition>
              </Grid.RowDefinitions>
              <Border BorderBrush="#FF193A56" BorderThickness="0,0,0,1" Padding="12,7">
                <StackPanel>
                  <TextBlock Text="Lưu trữ" Style="{StaticResource PanelTitle}">
                  </TextBlock>
                  <TextBlock Text="Dung lượng đĩa đang sử dụng" Foreground="#FFB7CDE0" FontSize="10" Margin="0,3,0,0">
                  </TextBlock>
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" Margin="12,8,12,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="94">
                  </RowDefinition>
                  <RowDefinition Height="*">
                  </RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125">
                    </ColumnDefinition>
                    <ColumnDefinition Width="*">
                    </ColumnDefinition>
                    <ColumnDefinition Width="126">
                    </ColumnDefinition>
                  </Grid.ColumnDefinitions>
                  <Grid Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Stroke="#FF263E52" StrokeThickness="10">
                    </Ellipse>
                    <Path x:Name="StorageUsageArc" Stroke="#FFFF7925" StrokeThickness="10" StrokeDashArray="0,100">
                      <Path.Data>
                        <EllipseGeometry Center="44,44" RadiusX="34" RadiusY="34">
                        </EllipseGeometry>
                      </Path.Data>
                      <UIElement.RenderTransform>
                        <RotateTransform Angle="-90" CenterX="44" CenterY="44">
                        </RotateTransform>
                      </UIElement.RenderTransform>
                    </Path>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="StorageUsageCenterText" Text="—" Foreground="#FFFFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                      </TextBlock>
                      <TextBlock Text="ĐANG DÙNG" Foreground="#FF9CB6CB" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0">
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                  <TextBlock Grid.Column="1" Text="Đang sử dụng" Foreground="#FFD6E5F3" FontSize="10" VerticalAlignment="Center">
                  </TextBlock>
                  <Grid Grid.Column="2" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF0B2032" BorderBrush="#FF193A56" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,5,0">
                      <TextBlock>
                        <Run Text="Đọc" Foreground="#FFB7CDE0" FontSize="9">
                        </Run>
                        <LineBreak>
                        </LineBreak>
                        <Run Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold">
                          <Run.Text>
                            <Binding Path="Text" ElementName="StorageReadText"/>
                          </Run.Text>
                        </Run>
                      </TextBlock>
                    </Border>
                    <Border Grid.Column="1" Background="#FF0B2032" BorderBrush="#FF193A56" BorderThickness="1" CornerRadius="5" Padding="8,4">
                      <TextBlock>
                        <Run Text="Ghi" Foreground="#FFB7CDE0" FontSize="9">
                        </Run>
                        <LineBreak>
                        </LineBreak>
                        <Run Foreground="#FFFFFFFF" FontSize="11" FontWeight="SemiBold">
                          <Run.Text>
                            <Binding Path="Text" ElementName="StorageWriteText"/>
                          </Run.Text>
                        </Run>
                      </TextBlock>
                    </Border>
                  </Grid>
                </Grid>
                <lvc:CartesianChart Grid.Row="1" LegendLocation="None" DisableAnimations="True" Hoverable="True" Foreground="#FFC7D9E9">
                  <lvc:CartesianChart.Series>
                    <Binding Path="StorageSeries"/>
                  </lvc:CartesianChart.Series>
                  <lvc:CartesianChart.DataTooltip>
                    <lvc:DefaultTooltip Background="#FF0A1D2D" Foreground="#FFFFFFFF" BorderBrush="#FFFF7925" BorderThickness="1" Padding="10,7">
                    </lvc:DefaultTooltip>
                  </lvc:CartesianChart.DataTooltip>
                  <lvc:CartesianChart.AxisX>
                    <lvc:Axis Foreground="#FF9AB2C8" FontSize="9">
                      <lvc:Axis.Labels>
                        <Binding Path="MetricHistoryLabels"/>
                      </lvc:Axis.Labels>
                      <lvc:Axis.Separator>
                        <lvc:Separator StrokeThickness="0" Step="3">
                        </lvc:Separator>
                      </lvc:Axis.Separator>
                    </lvc:Axis>
                  </lvc:CartesianChart.AxisX>
                  <lvc:CartesianChart.AxisY>
                    <lvc:Axis Foreground="#FF9AB2C8" FontSize="9">
                      <lvc:Axis.LabelFormatter>
                        <Binding Path="MegabytesLabelFormatter"/>
                      </lvc:Axis.LabelFormatter>
                      <lvc:Axis.Separator>
                        <lvc:Separator Stroke="#FF24445D" StrokeThickness="1">
                        </lvc:Separator>
                      </lvc:Axis.Separator>
                    </lvc:Axis>
                  </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
              </Grid>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Panel}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="50">
                </RowDefinition>
                <RowDefinition Height="*">
                </RowDefinition>
              </Grid.RowDefinitions>
              <Border BorderBrush="#FF193A56" BorderThickness="0,0,0,1" Padding="12,7">
                <StackPanel>
                  <TextBlock Text="Mạng và chất lượng luồng" Style="{StaticResource PanelTitle}">
                  </TextBlock>
                  <TextBlock Foreground="#FFB7CDE0" FontSize="10" Margin="0,3,0,0">
                    <TextBlock.Text>
                      <Binding Path="Text" ElementName="NetworkStatusText"/>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" Margin="12,8,12,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="43">
                  </RowDefinition>
                  <RowDefinition Height="*">
                  </RowDefinition>
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition>
                    </ColumnDefinition>
                    <ColumnDefinition>
                    </ColumnDefinition>
                  </Grid.ColumnDefinitions>
                  <Border Background="#FF0B2032" BorderBrush="#FF193A56" BorderThickness="1" CornerRadius="5" Padding="8,5">
                    <TextBlock>
                      <Run Text="RX" Foreground="#FFB7CDE0">
                      </Run>
                      <LineBreak>
                      </LineBreak>
                      <Run Foreground="#FFFFFFFF" FontWeight="SemiBold">
                        <Run.Text>
                          <Binding Path="Text" ElementName="NetworkRxText"/>
                        </Run.Text>
                      </Run>
                    </TextBlock>
                  </Border>
                  <Border Grid.Column="1" Background="#FF0B2032" BorderBrush="#FF193A56" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="8,0,0,0">
                    <TextBlock>
                      <Run Text="TX" Foreground="#FFB7CDE0">
                      </Run>
                      <LineBreak>
                      </LineBreak>
                      <Run Foreground="#FFFFFFFF" FontWeight="SemiBold">
                        <Run.Text>
                          <Binding Path="Text" ElementName="NetworkTxText"/>
                        </Run.Text>
                      </Run>
                    </TextBlock>
                  </Border>
                </Grid>
                <lvc:CartesianChart Grid.Row="1" LegendLocation="None" DisableAnimations="True" Hoverable="True" Foreground="#FFC7D9E9">
                  <lvc:CartesianChart.Series>
                    <Binding Path="NetworkSeries"/>
                  </lvc:CartesianChart.Series>
                  <lvc:CartesianChart.DataTooltip>
                    <lvc:DefaultTooltip Background="#FF0A1D2D" Foreground="#FFFFFFFF" BorderBrush="#FF27C96D" BorderThickness="1" Padding="10,7">
                    </lvc:DefaultTooltip>
                  </lvc:CartesianChart.DataTooltip>
                  <lvc:CartesianChart.AxisX>
                    <lvc:Axis Foreground="#FF9AB2C8" FontSize="9">
                      <lvc:Axis.Labels>
                        <Binding Path="MetricHistoryLabels"/>
                      </lvc:Axis.Labels>
                      <lvc:Axis.Separator>
                        <lvc:Separator StrokeThickness="0" Step="3">
                        </lvc:Separator>
                      </lvc:Axis.Separator>
                    </lvc:Axis>
                  </lvc:CartesianChart.AxisX>
                  <lvc:CartesianChart.AxisY>
                    <lvc:Axis Foreground="#FF9AB2C8" FontSize="9">
                      <lvc:Axis.LabelFormatter>
                        <Binding Path="NetworkRateLabelFormatter"/>
                      </lvc:Axis.LabelFormatter>
                      <lvc:Axis.Separator>
                        <lvc:Separator Stroke="#FF24445D" StrokeThickness="1">
                        </lvc:Separator>
                      </lvc:Axis.Separator>
                    </lvc:Axis>
                  </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Popup x:Name="CameraPickerPopup" Placement="Center" AllowsTransparency="True" StaysOpen="True">
      <Border Width="390" Height="520" Background="#FF0A1C2B" BorderBrush="#FF21415D" BorderThickness="1" CornerRadius="10" Padding="14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="32">
            </RowDefinition>
            <RowDefinition Height="34">
            </RowDefinition>
            <RowDefinition Height="*">
            </RowDefinition>
            <RowDefinition Height="40">
            </RowDefinition>
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="Chọn camera" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
            </TextBlock>
            <TextBlock x:Name="CameraPickerCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFB7CDE0" Text="0/6">
            </TextBlock>
          </Grid>
          <TextBox x:Name="CameraPickerSearch" Grid.Row="1" Background="#FF0D2538" BorderBrush="#FF24445E" Foreground="#FFFFFFFF" Padding="9,5" VerticalContentAlignment="Center" ToolTip="Danh sách camera thuộc profile hiện tại">
          </TextBox>
          <ScrollViewer Grid.Row="2" Margin="0,10">
            <ItemsControl x:Name="CameraPickerList">
              <ItemsControl.ItemsSource>
                <Binding Path="CameraPickerItems"/>
              </ItemsControl.ItemsSource>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#FF24445E" BorderThickness="1" CornerRadius="5" Margin="0,3" Padding="8,4">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Panel.Background" Value="#FF102B4A">
                        </Setter>
                        <Setter Property="UIElement.Opacity" Value="1">
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger>
                            <DataTrigger.Binding>
                              <Binding Path="IsSelected"/>
                            </DataTrigger.Binding>
                            <Setter Property="Panel.Background" Value="#FF24518B">
                            </Setter>
                            <Setter Property="Border.BorderBrush" Value="#FF5AA0FF">
                            </Setter>
                          </DataTrigger>
                          <DataTrigger>
                            <DataTrigger.Binding>
                              <Binding Path="CanSelect"/>
                            </DataTrigger.Binding>
                            <Setter Property="Panel.Background" Value="#FF081522">
                            </Setter>
                            <Setter Property="Border.BorderBrush" Value="#FF142A3C">
                            </Setter>
                            <Setter Property="UIElement.Opacity" Value="0.38">
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <CheckBox Foreground="#FFFFFFFF" FontSize="12" Cursor="Hand">
                      <ToggleButton.IsChecked>
                        <Binding Path="IsSelected"/>
                      </ToggleButton.IsChecked>
                      <UIElement.IsEnabled>
                        <Binding Path="CanSelect"/>
                      </UIElement.IsEnabled>
                      <TextBlock Foreground="#FFFFFFFF" FontWeight="SemiBold" Margin="6,0,0,0">
                        <TextBlock.Text>
                          <Binding Path="CameraName"/>
                        </TextBlock.Text>
                      </TextBlock>
                    </CheckBox>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Background="#00FFFFFF" BorderBrush="#FF24445E" Foreground="#FFC7D9E9" Padding="12,5" Margin="0,0,8,0">
            </Button>
            <Button Content="Hoàn tất" Background="#FF246FE8" BorderBrush="#FF246FE8" Foreground="#FFFFFFFF" Padding="12,5">
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Popup>
  </Grid>
</UserControl>
