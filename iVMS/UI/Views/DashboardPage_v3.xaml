          <Grid>
            <Border Width="58" Height="3" Background="#FF2380E8" CornerRadius="0,0,4,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-20,0,0">
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Tỷ lệ camera online" Foreground="#FF39A6FF" FontSize="11">
