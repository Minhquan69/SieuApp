<UserControl x:Class="V3SClient.UI.Views.DashboardPage_v3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:V3SClient.UI.Views"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="#071522"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#0A1C2B"/>
            <Setter Property="BorderBrush" Value="#193A56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="112"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#0B2032"/>
            <Setter Property="BorderBrush" Value="#24445E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C7D9E9"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="DashboardAddCameraButton" TargetType="Button">
            <Setter Property="Background" Value="#071522"/>
            <Setter Property="BorderBrush" Value="#2876E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D5E6F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="AddBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddBorder" Property="Background" Value="#102B4A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="AddBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#D7E6F4"/>
            <Setter Property="Background" Value="#0B2032"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="#24445E" BorderThickness="0,0,0,1"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#173A60"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1B4C80"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#D7E6F4"/>
            <Setter Property="Background" Value="#0B2032"/>
            <Setter Property="BorderBrush" Value="#24445E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><Grid><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><ToggleButton HorizontalAlignment="Right" Width="24" Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"><Path Data="M 0 0 L 7 0 L 3.5 4 Z" Fill="#9DB7CC" HorizontalAlignment="Center" VerticalAlignment="Center"/></ToggleButton></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#0B2032" BorderBrush="#24445E" BorderThickness="1" CornerRadius="3"><ScrollViewer MaxHeight="220" Padding="0"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="122"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,8">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Tổng quan vận hành" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="UpdatedText" Foreground="#C7D9E9" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource HeaderButton}" Click="Refresh_Click" ToolTip="Làm mới"><Icon:PackIconMaterial Kind="Refresh" Width="15" Height="15"/></Button>
                <Button x:Name="AutoRefreshButton" Style="{StaticResource HeaderButton}" Content="Auto 30s" Foreground="#367BFF" BorderBrush="#2862B5" Click="AutoRefresh_Click" Margin="0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,5,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" BorderBrush="#246FE8"><Grid><Border Width="58" Height="3" Background="#246FE8" CornerRadius="0,0,4,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-20,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Tổng số camera" Foreground="#367BFF" FontSize="11"/><TextBlock x:Name="TotalText" Text="0" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="Camera đang quản lý" Foreground="#D3E1EF" FontSize="10"/></StackPanel><Border Width="52" Height="52" CornerRadius="12" Background="#102B4A" HorizontalAlignment="Right" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="Cctv" Foreground="#2775FF" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#2380E8"><Grid><Border Width="58" Height="3" Background="#2380E8" CornerRadius="0,0,4,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-20,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Tỷ lệ camera online" Foreground="#39A6FF" FontSize="11"/><TextBlock x:Name="OnlineText" Text="0.0%" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="StatusText" Foreground="#D3E1EF" FontSize="10"/></StackPanel><Border Width="52" Height="52" CornerRadius="12" Background="#102B4A" HorizontalAlignment="Right" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="AccessPoint" Foreground="#39A6FF" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" BorderBrush="#8546D8"><Grid><Border Width="58" Height="3" Background="#8546D8" CornerRadius="0,0,4,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-20,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Phương tiện hôm nay" Foreground="#A66CFF" FontSize="11"/><TextBlock x:Name="VehicleText" Text="0" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="VehicleCompareText" Text="Theo profile hiện tại" Foreground="#D3E1EF" FontSize="10"/></StackPanel><Border Width="52" Height="52" CornerRadius="12" Background="#211B4B" HorizontalAlignment="Right" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="CarMultiple" Foreground="#A66CFF" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
            <Border Grid.Column="6" Style="{StaticResource Card}" BorderBrush="#188D5B"><Grid><Border Width="58" Height="3" Background="#18C86C" CornerRadius="0,0,4,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,-20,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Mật độ phương tiện" Foreground="#18C86C" FontSize="11"/><TextBlock x:Name="DensityText" Text="0" Foreground="White" FontSize="25" FontWeight="Bold"/><TextBlock Text="Phương tiện trong quy trình" Foreground="#D3E1EF" FontSize="10"/></StackPanel><Border Width="52" Height="52" CornerRadius="12" Background="#0D332D" HorizontalAlignment="Right" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="ChartBubble" Foreground="#18C86C" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Style="{StaticResource Panel}" Margin="0,0,6,6"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#193A56" BorderThickness="0,0,0,1" Padding="12,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="Pulse" Foreground="#2775FF" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Camera hệ thống" Style="{StaticResource PanelTitle}"/></StackPanel><ComboBox x:Name="CameraHistoryRangeComboBox" HorizontalAlignment="Right" VerticalAlignment="Center" Width="92" Height="26" SelectedIndex="3" SelectionChanged="CameraHistoryRange_SelectionChanged" Background="#0B2032" Foreground="#C7D9E9" BorderBrush="#24445E" FontSize="10"><ComboBoxItem Content="1 giờ qua" Tag="1"/><ComboBoxItem Content="6 giờ qua" Tag="6"/><ComboBoxItem Content="12 giờ qua" Tag="12"/><ComboBoxItem Content="1 ngày" Tag="24"/></ComboBox></Grid></Border><Grid Grid.Row="1" Margin="16,13,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="12" Height="12" Fill="#27C96D"/><TextBlock Text=" Trực tuyến" Foreground="#B9D1E8" FontSize="10" Margin="4,0,13,0"/><Ellipse Width="12" Height="12" Fill="#FF7085"/><TextBlock Text=" Ngoại tuyến" Foreground="#B9D1E8" FontSize="10" Margin="4,0,13,0"/><Ellipse Width="12" Height="12" Fill="#367BFF"/><TextBlock Text=" Hoạt động" Foreground="#B9D1E8" FontSize="10" Margin="4,0,0,0"/></StackPanel><ItemsControl Grid.Row="1" ItemsSource="{Binding CameraHistory}" VerticalAlignment="Bottom" Margin="15,12,15,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Height="170" Margin="4,0" VerticalAlignment="Bottom" ToolTipService.InitialShowDelay="120" ToolTipService.ShowDuration="10000"><Grid.ToolTip><ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="#10283A" BorderBrush="#367BFF" BorderThickness="1" Foreground="White" Padding="12,9" Placement="Mouse"><StackPanel><TextBlock Text="{Binding TimestampText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Online, StringFormat=Trực tuyến : {0}}" Foreground="#27C96D" Margin="0,5,0,0"/><TextBlock Text="{Binding Offline, StringFormat=Ngoại tuyến : {0}}" Foreground="#FF7085"/><TextBlock Text="{Binding UptimePercent, StringFormat=Hoạt động : {0:0.0}%}" Foreground="#4B8CFF"/></StackPanel></ToolTip></Grid.ToolTip><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions><Grid Grid.Row="0" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="5"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#27C96D" Height="{Binding OnlineHeight}" Width="14" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"/><Border Grid.Column="1" Background="#FF7085" Height="{Binding OfflineHeight}" Width="14" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"/><Border Grid.Column="2" Background="#367BFF" Height="{Binding UptimeHeight}" Width="3" VerticalAlignment="Bottom" CornerRadius="2" Opacity="0.9"/></Grid><TextBlock Grid.Row="1" Text="{Binding Label}" Foreground="#9AB2C8" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Grid></Border>
<Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,6,6,0"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#193A56" BorderThickness="0,0,0,1" Padding="12,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="CarMultiple" Foreground="#2775FF" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Phương tiện ghi nhận mới nhất" Style="{StaticResource PanelTitle}"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><ComboBox x:Name="LatestVehicleRangeComboBox" Width="92" Height="25" SelectedIndex="0" SelectionChanged="LatestVehicleRange_SelectionChanged" Background="#0B2032" Foreground="#C7D9E9" BorderBrush="#24445E" FontSize="10" Margin="0,0,8,0"><ComboBoxItem Content="Hôm nay" Tag="0"/><ComboBoxItem Content="1 giờ qua" Tag="1"/><ComboBoxItem Content="12 giờ qua" Tag="12"/><ComboBoxItem Content="24 giờ qua" Tag="24"/></ComboBox><TextBlock VerticalAlignment="Center" Text="Xem tất cả  ›" Foreground="#B7CDE0" FontSize="10"/></StackPanel></Grid></Border><Grid Grid.Row="1" Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions><TextBlock Text="BIỂN SỐ / ID" Foreground="#8EA7BC" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="LOẠI PHƯƠNG TIỆN" Foreground="#8EA7BC" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="CAMERA" Foreground="#8EA7BC" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="THỜI GIAN GHI NHẬN" Foreground="#8EA7BC" FontSize="9" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="ẢNH" Foreground="#8EA7BC" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding LatestVehicles}" Margin="14,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#17354C" BorderThickness="0,1,0,0" Padding="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width=".8*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Identifier}" Foreground="#3982FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding VehicleType}" Foreground="#D5E3EE" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding CameraId}" Foreground="#D5E3EE" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding TimeText}" Foreground="White" FontSize="11" VerticalAlignment="Center"/><Border Grid.Column="4" Width="40" Height="34" CornerRadius="5" Background="#102B42" HorizontalAlignment="Center" ClipToBounds="True"><Grid><Icon:PackIconMaterial Kind="ImageOff" Foreground="#7E9CB5" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Border>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
<Border Style="{StaticResource Panel}" Margin="6,0,0,6"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#193A56" BorderThickness="0,0,0,1" Padding="12,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="MapMarkerRadius" Foreground="#2775FF" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Phân bố camera" Style="{StaticResource PanelTitle}"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenFullMap_Click" Background="#0B2032" BorderBrush="#24445E" Foreground="#B7CDE0" FontSize="10" Padding="8,4" Content="Xem bản đồ đầy đủ ↗"/></Grid></Border><Border Grid.Row="1" ClipToBounds="True" BorderBrush="#193A56" BorderThickness="0,0,0,1"><local:MapPage_v3 UseSoftwareRendering="True" CompactOverviewMode="True"/></Border></Grid></Border>
<Border Grid.Row="1" Style="{StaticResource Panel}" Margin="6,6,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border BorderBrush="#193A56" BorderThickness="0,0,0,1" Padding="12,0"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="CameraOutline" Foreground="#2775FF" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Camera trực tiếp" Style="{StaticResource PanelTitle}"/><Ellipse Width="7" Height="7" Fill="#27C96D" Margin="7,0,4,0" VerticalAlignment="Center"/><TextBlock Text="Live Quick View" Foreground="#9EE7BF" FontSize="9" VerticalAlignment="Center"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal"><Button Click="ScrollLiveLeft_Click" Width="28" Height="25" Margin="0,0,5,0" Padding="0" Background="#0B2032" BorderBrush="#24445E"><Icon:PackIconMaterial Kind="ChevronLeft" Foreground="#C7D9E9" Width="15" Height="15"/></Button><Button Click="ScrollLiveRight_Click" Width="28" Height="25" Margin="0,0,8,0" Padding="0" Background="#0B2032" BorderBrush="#24445E"><Icon:PackIconMaterial Kind="ChevronRight" Foreground="#C7D9E9" Width="15" Height="15"/></Button><Button Click="OpenFullLive_Click" Background="#0B2032" BorderBrush="#24445E" Foreground="#B7CDE0" FontSize="10" Padding="8,4" Content="Xem đầy đủ camera"/></StackPanel></Grid></Border><Border Grid.Row="1" ClipToBounds="True"><WrapPanel x:Name="LivePreviewHost" Margin="10,8"/></Border></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
    <Popup x:Name="CameraPickerPopup" Placement="Center" AllowsTransparency="True" StaysOpen="True">
        <Border Width="390" Height="520" Background="#0A1C2B" BorderBrush="#21415D" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="Chọn camera" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/><TextBlock x:Name="CameraPickerCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B7CDE0" Text="0/6"/></Grid>
                <TextBox Grid.Row="1" x:Name="CameraPickerSearch" Background="#0D2538" BorderBrush="#24445E" Foreground="White" Padding="9,5" VerticalContentAlignment="Center" ToolTip="Danh sách camera thuộc profile hiện tại"/>
                <ScrollViewer Grid.Row="2" Margin="0,10"><ItemsControl x:Name="CameraPickerList" ItemsSource="{Binding CameraPickerItems}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#24445E" BorderThickness="1" CornerRadius="5" Margin="0,3" Padding="8,4"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#102B4A"/><Setter Property="Opacity" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#24518B"/><Setter Property="BorderBrush" Value="#5AA0FF"/></DataTrigger><DataTrigger Binding="{Binding CanSelect}" Value="False"><Setter Property="Background" Value="#081522"/><Setter Property="BorderBrush" Value="#142A3C"/><Setter Property="Opacity" Value="0.38"/></DataTrigger></Style.Triggers></Style></Border.Style><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Checked="CameraPickerToggleChanged" Unchecked="CameraPickerToggleChanged" Foreground="White" FontSize="12" Cursor="Hand"><TextBlock Text="{Binding CameraName}" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0"/></CheckBox></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="CancelCameraPicker_Click" Content="Hủy" Background="Transparent" BorderBrush="#24445E" Foreground="#C7D9E9" Padding="12,5" Margin="0,0,8,0"/><Button Click="ApplyCameraPicker_Click" Content="Hoàn tất" Background="#246FE8" BorderBrush="#246FE8" Foreground="White" Padding="12,5"/></StackPanel>
            </Grid>
        </Border>
    </Popup>
    </Grid>
</UserControl>
