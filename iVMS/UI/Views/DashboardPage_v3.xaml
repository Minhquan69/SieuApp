<UserControl x:Class="V3SClient.UI.Views.DashboardPage_v3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:V3SClient.UI.Views" xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" Background="#FF071522" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="Panel" TargetType="{x:Type Border}">
        <Setter Property="Panel.Background" Value="#FF0A1C2B">
        </Setter>
        <Setter Property="Border.BorderBrush" Value="#FF193A56">
        </Setter>
        <Setter Property="Border.BorderThickness" Value="1">
        </Setter>
        <Setter Property="Border.CornerRadius" Value="10">
        </Setter>
        <Setter Property="UIElement.ClipToBounds" Value="True">
        </Setter>
      </Style>
      <Style x:Key="Card" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel}">
        <Setter Property="Border.Padding" Value="20,20,20,5">
        </Setter>
        <Setter Property="FrameworkElement.MinHeight" Value="112">
        </Setter>
        <Setter Property="Border.BorderThickness" Value="1,1,1,2">
        </Setter>
        <Setter Property="FrameworkElement.Cursor" Value="Hand">
        </Setter>
        <Setter Property="UIElement.RenderTransformOrigin" Value="0.5,0.5">
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Panel.Background" Value="#FF102A3C">
            </Setter>
            <Setter Property="UIElement.RenderTransform">
              <Setter.Value>
                <ScaleTransform ScaleX="1.025" ScaleY="1.025">
                </ScaleTransform>
              </Setter.Value>
            </Setter>
            <Setter Property="Panel.ZIndex" Value="2">
            </Setter>
            <Setter Property="UIElement.Effect">
              <Setter.Value>
                <DropShadowEffect Color="#2862B5" BlurRadius="16" ShadowDepth="0" Opacity="0.32">
                </DropShadowEffect>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HeaderButton" TargetType="{x:Type Button}">
        <Setter Property="Panel.Background" Value="#FF0B2032">
        </Setter>
        <Setter Property="Border.BorderBrush" Value="#FF24445E">
        </Setter>
        <Setter Property="Border.BorderThickness" Value="1">
        </Setter>
        <Setter Property="TextElement.Foreground" Value="#FFC7D9E9">
        </Setter>
        <Setter Property="Control.Padding" Value="9,5">
        </Setter>
        <Setter Property="FrameworkElement.Margin" Value="0,0,8,0">
        </Setter>
        <Setter Property="FrameworkElement.Cursor" Value="Hand">
        </Setter>
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="RangeBorder" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}">
                </ContentPresenter>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="RangeBorder" Property="Border.BorderBrush" Value="#FF4C8FFF">
                  </Setter>
                  <Setter TargetName="RangeBorder" Property="Panel.Background" Value="#FF102C4D">
                  </Setter>
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="RangeBorder" Property="UIElement.Opacity" Value="0.8">
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PanelTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="TextElement.Foreground" Value="#FFFFFFFF">
        </Setter>
        <Setter Property="TextElement.FontWeight" Value="SemiBold">
        </Setter>
        <Setter Property="TextElement.FontSize" Value="13">
        </Setter>
      </Style>
      <Style x:Key="CameraRangeButton" TargetType="{x:Type Button}">
        <Setter Property="Panel.Background" Value="#00FFFFFF">
        </Setter>
        <Setter Property="TextElement.Foreground" Value="#FFCBDCED">
        </Setter>
        <Setter Property="Border.BorderBrush" Value="#FF2C6292">
        </Setter>
        <Setter Property="Border.BorderThickness" Value="1.5">
        </Setter>
        <Setter Property="TextElement.FontSize" Value="10">
        </Setter>
        <Setter Property="TextElement.FontWeight" Value="SemiBold">
        </Setter>
        <Setter Property="Control.Padding" Value="10,6">
        </Setter>
        <Setter Property="FrameworkElement.Margin" Value="4,0,0,0">
        </Setter>
        <Setter Property="FrameworkElement.Cursor" Value="Hand">
        </Setter>
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="RangeBorder" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}">
                </ContentPresenter>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="RangeBorder" Property="Border.BorderBrush" Value="#FF6AA5FF">
                  </Setter>
                  <Setter TargetName="RangeBorder" Property="Panel.Background" Value="#FF102C4D">
                  </Setter>
                </Trigger>
                <Trigger Property="ButtonBase.IsPressed" Value="True">
                  <Setter TargetName="RangeBorder" Property="UIElement.Opacity" Value="0.82">
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DashboardAddCameraButton" TargetType="{x:Type Button}">
        <Setter Property="Panel.Background" Value="#FF071522">
        </Setter>
        <Setter Property="Border.BorderBrush" Value="#FF2876E8">
        </Setter>
        <Setter Property="Border.BorderThickness" Value="1">
        </Setter>
        <Setter Property="TextElement.Foreground" Value="#FFD5E6F7">
        </Setter>
        <Setter Property="FrameworkElement.Cursor" Value="Hand">
        </Setter>
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border x:Name="AddBorder" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" CornerRadius="7">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                </ContentPresenter>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="AddBorder" Property="Panel.Background" Value="#FF102B4A">
                  </Setter>
                </Trigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter TargetName="AddBorder" Property="UIElement.Opacity" Value="0.45">
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="TextElement.Foreground" Value="#FFD7E6F4">
        </Setter>
        <Setter Property="Panel.Background" Value="#FF0B2032">
        </Setter>
        <Setter Property="Control.Padding" Value="9,5">
        </Setter>
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border x:Name="ItemBorder" Background="{TemplateBinding Panel.Background}" BorderBrush="#FF24445E" BorderThickness="0,0,0,1">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center">
                </ContentPresenter>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="ItemBorder" Property="Panel.Background" Value="#FF173A60">
                  </Setter>
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="ItemBorder" Property="Panel.Background" Value="#FF1B4C80">
                  </Setter>
                  <Setter Property="TextElement.Foreground" Value="#FFFFFFFF">
                  </Setter>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="TextElement.Foreground" Value="#FFD7E6F4">
        </Setter>
        <Setter Property="Panel.Background" Value="#FF0B2032">
        </Setter>
        <Setter Property="Border.BorderBrush" Value="#FF24445E">
        </Setter>
        <Setter Property="Border.BorderThickness" Value="1">
        </Setter>
        <Setter Property="Control.Padding" Value="8,0">
        </Setter>
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border x:Name="ComboBorder" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" CornerRadius="4">
                  <Grid>
                    <ContentPresenter Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}">
                    </ContentPresenter>
                    <ToggleButton HorizontalAlignment="Right" Width="24" Background="#00FFFFFF" BorderThickness="0" Focusable="False">
                      <ToggleButton.IsChecked>
                        <Binding Path="IsDropDownOpen"><Binding.RelativeSource>
                            <RelativeSource Mode="TemplatedParent"/>
                          </Binding.RelativeSource>
                        </Binding>
                      </ToggleButton.IsChecked>
                      <Path Data="M0,0L7,0 3.5,4z" Fill="#FF9DB7CC" HorizontalAlignment="Center" VerticalAlignment="Center">
                      </Path>
                    </ToggleButton>
                  </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="Fade">
                  <Border Background="#FF0B2032" BorderBrush="#FF24445E" BorderThickness="1" CornerRadius="3">
                    <FrameworkElement.MinWidth>
                      <Binding Path="ActualWidth"><Binding.RelativeSource>
                          <RelativeSource Mode="TemplatedParent"/>
                        </Binding.RelativeSource>
                      </Binding>
                    </FrameworkElement.MinWidth>
                    <ScrollViewer MaxHeight="220" Padding="0">
                      <StackPanel IsItemsHost="True">
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid Margin="10">
      <Grid.RowDefinitions>
        <RowDefinition Height="36">
        </RowDefinition>
        <RowDefinition Height="122">
        </RowDefinition>
        <RowDefinition Height="*">
        </RowDefinition>
