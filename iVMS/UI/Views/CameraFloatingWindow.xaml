<Window x:Class="V3SClient.UI.Views.CameraFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera Live"
        Width="760" Height="458" MinWidth="560" MinHeight="346"
        WindowStyle="None"
        Background="#1A1A1A"
        ShowInTaskbar="False" Topmost="False"
        ResizeMode="CanResizeWithGrip" SizeChanged="CameraFloatingWindow_SizeChanged">
    <Border x:Name="mainBorder" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Direction="270" Opacity="0.5" ShadowDepth="3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#111111" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Border Background="#E87E04" Width="3" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtCamName" Foreground="#EAF2FF" FontWeight="SemiBold" FontSize="12"
                               Margin="12,0,76,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0">
                        <Button Content="⛶" Width="28" Height="24"
                                Background="Transparent" Foreground="#D6E4F5" FontSize="15"
                                BorderThickness="0" Click="BtnFullscreen_Click" Cursor="Hand" ToolTip="Toàn màn hình"/>
                        <Button Content="X" Width="28" Height="24"
                                Background="Transparent" Foreground="#FF6B6B" FontSize="12" FontWeight="Bold"
                                BorderThickness="0" Click="BtnStop_Click" Cursor="Hand" ToolTip="Tắt luồng"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="gridCameraView" Grid.Row="1" Background="Black" Margin="1,0,1,1"
                  SizeChanged="CameraContainer_SizeChanged"/>
        </Grid>
    </Border>
</Window>
