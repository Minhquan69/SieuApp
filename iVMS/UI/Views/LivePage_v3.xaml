<UserControl x:Class="V3SClient.UI.Views.LivePage_v3"
             x:Name="LivePageRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{StaticResource VmsBackgroundBrush_v3}">
    <UserControl.Resources>
        <Style x:Key="LiveHeaderActionStyle_v3" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource VmsSurface2Brush_v3}"/>
            <Setter Property="BorderBrush" Value="{StaticResource VmsBorderBrush_v3}"/>
            <Setter Property="Foreground" Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource VmsPrimaryHoverBrush_v3}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VmsPrimaryBrush_v3}"/>
                    <Setter Property="Foreground" Value="{StaticResource VmsTextInverseBrush_v3}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource VmsPrimaryPressedBrush_v3}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource VmsPrimaryPressedBrush_v3}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiTimeContextMenuStyle_v3" TargetType="ContextMenu">
            <Setter Property="Background" Value="#0C2132"/>
            <Setter Property="BorderBrush" Value="{StaticResource VmsPrimaryBorderBrush_v3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AiTimeMenuItemStyle_v3" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="4"><ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1A2563EB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#332563EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CollapsedCameraListButtonStyle_v3" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle_v3}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A2563EB"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#332563EB"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiFeedCardStyle_v3" TargetType="Border">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background"><Setter.Value><SolidColorBrush Color="#0E2234"/></Setter.Value></Setter>
            <Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="#38546A"/></Setter.Value></Setter>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.32"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.32"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" From="#38BDF8" To="#38546A" Duration="0:0:2.8"/>
                                <ColorAnimation Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" From="#123D57" To="#0E2234" Duration="0:0:2.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUpdated}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetProperty="BorderBrush.(SolidColorBrush.Color)" From="#38BDF8" To="#38546A" Duration="0:0:2.8"/>
                                <ColorAnimation Storyboard.TargetProperty="Background.(SolidColorBrush.Color)" From="#123D57" To="#0E2234" Duration="0:0:2.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiFeedRefreshInputStyle_v3" TargetType="TextBox">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7,2"/>
            <Setter Property="Background" Value="#0B2032"/><Setter Property="Foreground" Value="#E2EEF7"/>
            <Setter Property="BorderBrush" Value="#2A5574"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#3B82F6"/><Setter TargetName="InputBorder" Property="Background" Value="#102A40"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#3C6E91"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AiFeedIconButtonStyle_v3" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#0D2639"/><Setter Property="BorderBrush" Value="#244B68"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#C7D9E8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#153954"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#3B82F6"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1A4C70"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AiFeedDetailButtonStyle_v3" TargetType="Button" BasedOn="{StaticResource AiFeedIconButtonStyle_v3}">
            <Setter Property="Width" Value="Auto"/><Setter Property="Padding" Value="10,0"/><Setter Property="Foreground" Value="#CFE4F5"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border x:Name="LivePageHeader" MouseLeftButtonDown="LivePageHeader_MouseLeftButtonDown" HorizontalAlignment="Stretch"
                Background="{StaticResource VmsSidebarBrush_v3}" BorderBrush="{StaticResource VmsBorderSubtleBrush_v3}"
                BorderThickness="0,0,0,1" Padding="0">
            <Grid x:Name="LiveHeaderLayoutGrid">
                <Grid.Resources>
                    <Style x:Key="LiveHeaderMinimalButtonStyle_v3" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle_v3}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A2563EB"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#332563EB"/></Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="LiveHeaderActionStyle_v3" TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource VmsSurface2Brush_v3}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource VmsBorderBrush_v3}"/>
                        <Setter Property="Foreground" Value="{StaticResource VmsTextPrimaryBrush_v3}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource VmsPrimaryHoverBrush_v3}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource VmsPrimaryBrush_v3}"/>
                                <Setter Property="Foreground" Value="{StaticResource VmsTextInverseBrush_v3}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource VmsPrimaryPressedBrush_v3}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource VmsPrimaryPressedBrush_v3}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="230"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
                <!-- Thanh tiện ích vận hành: tách biệt hoàn toàn với bảng thông báo AI. -->
                <Border Grid.Row="0" Grid.ColumnSpan="4" Background="Transparent" BorderThickness="0"/>
                <StackPanel x:Name="HeaderTitlePanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" Background="Transparent" BorderThickness="0" CornerRadius="7" Margin="0,0,10,0">
                        <Icon:PackIconMaterial Kind="CameraOutline" Width="16" Height="16" Foreground="{StaticResource VmsFocusBrush_v3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="GIÁM SÁT TRỰC TIẾP" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                    <Border Height="30" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="7,0" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="CameraOutline" Width="13" Height="13" Foreground="{StaticResource VmsPrimaryBrush_v3}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="11" VerticalAlignment="Center"><Run Text=""/><Run Text="{Binding CameraCount, Mode=OneWay}"/><Run Text=" camera"/></TextBlock></StackPanel>
                    </Border>
                    <Border Height="30" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="7,0" Margin="5,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="AccessPoint" Width="13" Height="13" Foreground="{StaticResource VmsSuccessBrush_v3}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="11" VerticalAlignment="Center"><Run Text=""/><Run Text="{Binding OnlineCameraCount, Mode=OneWay}"/><Run Text=" trực tuyến"/></TextBlock></StackPanel>
                    </Border>
                    <Border Height="30" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Padding="7,0" Margin="5,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Icon:PackIconMaterial Kind="AccountGroupOutline" Width="13" Height="13" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" Margin="0,0,5,0" VerticalAlignment="Center"/><TextBlock Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="11" VerticalAlignment="Center"><Run Text=""/><Run Text="{Binding GroupCount, Mode=OneWay}"/><Run Text=" nhóm"/></TextBlock></StackPanel>
                    </Border>
                    <TextBlock x:Name="CameraStatus" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="HeaderLayoutQuickPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Visible">
                        <Button Tag="Layout1x1" Click="LayoutButton_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="8,5" Margin="1" ToolTip="1 camera"><Icon:PackIconMaterial Kind="CheckboxBlankOutline" Width="15" Height="15"/></Button>
                        <Button Tag="Layout2x2" Click="LayoutButton_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="8,5" Margin="1" ToolTip="4 camera · 2 × 2"><Icon:PackIconMaterial Kind="ViewDashboardOutline" Width="15" Height="15"/></Button>
                        <Button Tag="Layout3x3" Click="LayoutButton_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="8,5" Margin="1" ToolTip="9 camera · 3 × 3"><Icon:PackIconMaterial Kind="ViewModule" Width="15" Height="15"/></Button>
                        <Button x:Name="HeaderLayoutButton" Click="LayoutMenuButton_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="8,5" Margin="1" ToolTip="Các bố cục khác"><Icon:PackIconMaterial Kind="DotsHorizontal" Width="16" Height="16"/></Button>
                    </StackPanel>
                    <StackPanel x:Name="HeaderActionPanel" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Visible">
                    <Border Width="1" Height="28" Background="#24435A" Margin="10,0,9,0" VerticalAlignment="Center"/>
                    <StackPanel x:Name="HeaderUtilityPanel" Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Click="SnapshotAll_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="9,5" Margin="1" ToolTip="Chụp ảnh tất cả camera"><Icon:PackIconMaterial Kind="CameraOutline" Width="16" Height="16"/></Button>
                        <Button x:Name="GridFullscreenButton" Click="FullscreenButton_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="9,5" Margin="1" ToolTip="Toàn màn hình lưới"><Icon:PackIconMaterial x:Name="GridFullscreenIcon" Kind="Fullscreen" Width="16" Height="16"/></Button>
                        <Button x:Name="BulkConnectionButton" Click="ToggleAllConnection_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="10,6" Margin="3" ToolTip="Ngắt kết nối tất cả"><Icon:PackIconMaterial x:Name="BulkConnectionIcon" Kind="PowerPlugOff" Width="16" Height="16"/></Button>
                        <Button x:Name="RemoveFailedOfflineHeaderButton" Click="RemoveFailedOffline_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="9,5" Margin="1" ToolTip="Xóa camera lỗi hoặc ngoại tuyến" Visibility="Collapsed"><Icon:PackIconMaterial Kind="CloseCircleOutline" Width="16" Height="16" Foreground="{StaticResource VmsWarningBrush_v3}"/></Button>
                        <Button Click="RemoveAll_Click" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="9,5" Margin="1" ToolTip="Xóa tất cả camera khỏi lưới"><Icon:PackIconMaterial Kind="DeleteSweepOutline" Width="16" Height="16"/></Button>
                    </StackPanel>
                </StackPanel>
                </StackPanel>
                <!-- Khối AI riêng để số liệu giám sát luôn nổi bật, không lẫn với tiện ích camera. -->
                <Border x:Name="AiSummaryPanel" Grid.Row="1" Grid.ColumnSpan="4" Background="#102C40" BorderBrush="#2A6686" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="14,8,286,9"><Border.Effect><DropShadowEffect Color="#1C5D82" BlurRadius="10" ShadowDepth="0" Opacity="0.16"/></Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="118"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="30" Height="30" Background="#55D8FF" BorderBrush="#A7EEFF" BorderThickness="1" CornerRadius="15"><Image Source="/Assets/Images/ai-monitoring-logo.png" Width="18" Height="18" Stretch="Uniform" Opacity="0.95"/></Border><TextBlock Text="AI GIÁM SÁT" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        <Border Grid.Column="1" Background="#24435A" Margin="0,2"/>
                        <Grid x:Name="AiSummaryDetails" Grid.Column="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Icon:PackIconMaterial Kind="CarOutline" Width="25" Height="25" Foreground="#00C8ED"/><StackPanel Margin="8,0,0,0"><TextBlock Text="PHƯƠNG TIỆN" Foreground="#D5E2EC" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="AiVehicleCountText" Text="0" Foreground="#00C8ED" FontSize="20" FontWeight="Bold" LineHeight="19"/></StackPanel></StackPanel>
                            <Border Grid.Column="1" Background="#24435A" Margin="0,2"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Icon:PackIconMaterial Kind="AccountOutline" Width="24" Height="24" Foreground="#00D27A"/><StackPanel Margin="8,0,0,0"><TextBlock Text="NGƯỜI" Foreground="#D5E2EC" FontSize="9" FontWeight="Bold"/><TextBlock Text="7" Foreground="#00D27A" FontSize="20" FontWeight="Bold" LineHeight="19"/></StackPanel></StackPanel>
                            <Border Grid.Column="3" Background="#24435A" Margin="0,2"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Icon:PackIconMaterial Kind="CarSpeedLimiter" Width="24" Height="24" Foreground="#A78BFA"/><StackPanel Margin="8,0,0,0"><TextBlock Text="MẬT ĐỘ XE" Foreground="#D5E2EC" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="AiTrafficDensityText" Text="0" Foreground="#A78BFA" FontSize="20" FontWeight="Bold" LineHeight="19"/></StackPanel></StackPanel>
                            <Border Grid.Column="5" Background="#24435A" Margin="0,2"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Icon:PackIconMaterial Kind="AlertCircleOutline" Width="24" Height="24" Foreground="#FFD200"/><StackPanel Margin="8,0,0,0"><TextBlock Text="BẤT THƯỜNG" Foreground="#D5E2EC" FontSize="9" FontWeight="Bold"/><TextBlock Text="3" Foreground="#FFD200" FontSize="20" FontWeight="Bold" LineHeight="19"/></StackPanel></StackPanel>
                            <Border Grid.Column="7" Background="#24435A" Margin="0,2"/>
                            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><Icon:PackIconMaterial Kind="BellAlertOutline" Width="24" Height="24" Foreground="#FF4D63"/><StackPanel Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="CẦN XỬ LÝ" Foreground="#D5E2EC" FontSize="9" FontWeight="Bold"/><Ellipse Width="5" Height="5" Fill="#FF4D63" Margin="5,1,0,0" VerticalAlignment="Top"/></StackPanel><TextBlock Text="2" Foreground="#FF4D63" FontSize="20" FontWeight="Bold" LineHeight="19"/></StackPanel></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel x:Name="HeaderTopOverflowPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Visible">
                    <Button x:Name="AiSummaryExpandButton" Click="ToggleAiSummary_Click" Visibility="Collapsed" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="7,3" Margin="1" ToolTip="Mở bảng thông tin AI"><Icon:PackIconMaterial Kind="HeadCogOutline" Width="18" Height="18" Foreground="#54D8FF"/></Button>
                    <Button x:Name="CollapsedCameraListHeaderButton" Click="ToggleSidebar_Click" Visibility="Collapsed" Style="{StaticResource CollapsedCameraListButtonStyle_v3}" Padding="8,3" Margin="5,1,1,1" ToolTip="Mở danh sách camera"><StackPanel Orientation="Horizontal"><Icon:PackIconMaterial Kind="VideoOutline" Width="16" Height="16" Foreground="{StaticResource VmsPrimaryBrush_v3}" Margin="0,0,7,0"/><TextBlock Text="Danh sách camera" FontWeight="SemiBold"/><Icon:PackIconMaterial x:Name="CollapsedCameraListHeaderIcon" Kind="ChevronDown" Width="15" Height="15" Margin="9,0,0,0"/></StackPanel></Button>
                    <Button x:Name="SidebarOpenHeaderButton" Click="ToggleSidebar_Click" Visibility="Collapsed" Style="{StaticResource LiveHeaderMinimalButtonStyle_v3}" Padding="9,5" Margin="5,1,2,1" ToolTip="Mở danh sách camera"><StackPanel Orientation="Horizontal"><Icon:PackIconMaterial Kind="VideoOutline" Width="16" Height="16" Foreground="{StaticResource VmsPrimaryBrush_v3}" Margin="0,0,7,0"/><TextBlock Text="Mở danh sách camera" FontWeight="SemiBold"/><Icon:PackIconMaterial Kind="ChevronLeft" Width="15" Height="15" Margin="8,0,0,0"/></StackPanel></Button>
                </StackPanel>
                <StackPanel x:Name="HeaderRightAiControls" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button x:Name="AiTimeFilterButton" Click="AiTimeFilterButton_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="10,5" Margin="1" ToolTip="Chọn khoảng thời gian AI"><Button.ContextMenu><ContextMenu Style="{StaticResource AiTimeContextMenuStyle_v3}"><MenuItem Style="{StaticResource AiTimeMenuItemStyle_v3}" Header="15 phút gần nhất" Tag="15 phút gần nhất" Click="AiTimeFilter_Click"/><MenuItem Style="{StaticResource AiTimeMenuItemStyle_v3}" Header="1 giờ gần nhất" Tag="1 giờ gần nhất" Click="AiTimeFilter_Click"/><MenuItem Style="{StaticResource AiTimeMenuItemStyle_v3}" Header="6 giờ gần nhất" Tag="6 giờ gần nhất" Click="AiTimeFilter_Click"/><MenuItem Style="{StaticResource AiTimeMenuItemStyle_v3}" Header="12 giờ gần nhất" Tag="12 giờ gần nhất" Click="AiTimeFilter_Click"/><MenuItem Style="{StaticResource AiTimeMenuItemStyle_v3}" Header="1 ngày gần nhất" Tag="1 ngày gần nhất" Click="AiTimeFilter_Click"/></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><Icon:PackIconMaterial Kind="ClockOutline" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock x:Name="AiTimeFilterText" Text="15 phút gần nhất" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11"/><Icon:PackIconMaterial Kind="ChevronDown" Width="15" Height="15" Margin="8,0,0,0"/></StackPanel></Button>
                            <Button x:Name="AiSummaryCollapseButton" Click="ToggleAiSummary_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="4" Margin="3,1,1,1" ToolTip="Thu gọn bảng AI"><Icon:PackIconMaterial x:Name="AiSummaryCollapseIcon" Kind="ChevronUp" Width="18" Height="18"/></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SidebarColumn" Width="0.20*" MinWidth="210" MaxWidth="320"/></Grid.ColumnDefinitions>
            <Grid x:Name="CameraHeaderWidthHost" Grid.Column="0" IsHitTestVisible="False"/>
            <Grid x:Name="CameraGridHost" Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="4" Panel.ZIndex="20" Background="{StaticResource VmsElevatedBrush_v3}" BorderBrush="{StaticResource VmsBorderStrongBrush_v3}" BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Layout" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" VerticalAlignment="Center" Margin="2,0,5,0" FontSize="11"/>
                        <Button Content="1x1" Tag="Layout1x1" Click="LayoutButton_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Padding="6,3" Margin="1"/>
                        <Button Content="2x2" Tag="Layout2x2" Click="LayoutButton_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Padding="6,3" Margin="1"/>
                        <Button Content="3x3" Tag="Layout3x3" Click="LayoutButton_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Padding="6,3" Margin="1"/>
                        <Button Content="5+1" Tag="Layout5Plus1" Click="LayoutButton_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Padding="6,3" Margin="1"/>
                        <Button Content="16+1" Tag="Layout16Plus1" Click="LayoutButton_Click" Style="{StaticResource SecondaryButtonStyle_v3}" Padding="6,3" Margin="1"/>
                        <TextBox x:Name="InlineCustomSlotText" Text="10" Width="38" Height="24" Style="{StaticResource VmsTextBoxStyle_v3}" Margin="3,0,1,0" ToolTip="Number of custom tiles"/>
                        <Button Content="Apply" Click="OpenCustomLayoutEditor_Click" Style="{StaticResource PrimaryButtonStyle_v3}" Padding="6,3" Margin="1"/>
                    </StackPanel>
                </Border>
                <ScrollViewer x:Name="CameraGridViewport" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource VmsBackgroundBrush_v3}" SizeChanged="CameraGridViewport_SizeChanged">
                    <Grid x:Name="CameraGrid" AllowDrop="True"/>
                </ScrollViewer>
