                </StackPanel>
                <ScrollViewer x:Name="AiFeedScroller" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled" CanContentScroll="False" PanningMode="HorizontalOnly" PanningDeceleration="0.001" HorizontalContentAlignment="Left" IsManipulationEnabled="True" PreviewMouseWheel="AiFeedScroller_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding AiEventFeedItems, ElementName=LivePageRoot}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="270" Height="112" Style="{StaticResource AiFeedCardStyle_v3}" CornerRadius="10" Margin="0,0,10,0" Padding="9" Cursor="Hand" MouseLeftButtonUp="AiFeedItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="78" Height="78" CornerRadius="7" Background="#172E42" ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid>
                                                <Image Source="{Binding CropImage}" Stretch="UniformToFill"/>
                                                <Icon:PackIconMaterial Kind="CameraOutline" Width="27" Height="27" Foreground="#66839B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Icon:PackIconMaterial.Style><Style TargetType="Icon:PackIconMaterial"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CropImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Icon:PackIconMaterial.Style>
                                                </Icon:PackIconMaterial>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Column="1" Margin="1,0,0,0">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid><TextBlock Text="{Binding Title}" Foreground="#F8FAFC" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,22,0"/><Icon:PackIconMaterial Kind="EyeOutline" Width="14" Height="14" Foreground="#60A5FA" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Xem chi tiết sự kiện"/></Grid>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"><Icon:PackIconMaterial Kind="CameraOutline" Width="12" Height="12" Foreground="#8FA9BE" Margin="0,0,5,0"/><TextBlock Text="{Binding CameraId}" Foreground="#B5C7D8" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0"><Icon:PackIconMaterial Kind="ClockOutline" Width="12" Height="12" Foreground="#8FA9BE" Margin="0,0,5,0"/><TextBlock Text="{Binding EventTime}" Foreground="#92A7BA" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                                            <Grid Grid.Row="3" Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Icon:PackIconMaterial Kind="ShieldCheckOutline" Width="13" Height="13" Foreground="#10C985" Margin="0,0,5,0"/><TextBlock Grid.Column="1" Text="{Binding ConfidencePercent, StringFormat={}{0:F0}%}" Foreground="#34D399" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><ProgressBar Grid.Column="2" Value="{Binding ConfidencePercent}" Maximum="100" Height="4" Margin="5,0,0,0" Foreground="#10C985" Background="#24445A" BorderThickness="0" VerticalAlignment="Center"/></Grid>
                                        </Grid>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0E7490" CornerRadius="7" Padding="6,2" Margin="0,1,1,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="MỚI" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1D4ED8" CornerRadius="7" Padding="6,2" Margin="0,1,1,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsUpdated}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="ĐÃ CẬP NHẬT" Foreground="White" FontSize="8" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="AiFeedEmptyState" Grid.Row="1" Grid.ColumnSpan="2" Text="Chưa có sự kiện AI trong hôm nay" Foreground="#7E98AE" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding AiEventFeedItems.Count, ElementName=LivePageRoot}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Popup x:Name="AiFeedDetailsPopup" PlacementTarget="{Binding ElementName=LivePageRoot}" Placement="Center" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
        <Grid x:Name="AiFeedDetailsOverlay" Background="#C7000D18" MouseLeftButtonDown="AiFeedDetailsOverlay_MouseLeftButtonDown">
            <Border Width="390" HorizontalAlignment="Right" Background="#0D2132" BorderBrush="#24445E" BorderThickness="1,0,0,0" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Grid Margin="0,0,0,16"><StackPanel><TextBlock Text="AI EVENT" Foreground="#3B82F6" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel><Button HorizontalAlignment="Right" Click="CloseAiFeedDetails_Click" Background="#1B354B" BorderBrush="#3B5B73" BorderThickness="1" Width="36" Height="36" Padding="8" ToolTip="Đóng"><Icon:PackIconMaterial Kind="Close" Width="16" Height="16"/></Button></Grid>
                    <Border Height="260" CornerRadius="12" Background="#172E42" ClipToBounds="True"><Grid><Image Source="{Binding CropImage}" Stretch="UniformToFill"/><Icon:PackIconMaterial Kind="CameraOutline" Width="38" Height="38" Foreground="#66839B" HorizontalAlignment="Center" VerticalAlignment="Center"><Icon:PackIconMaterial.Style><Style TargetType="Icon:PackIconMaterial"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CropImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Icon:PackIconMaterial.Style></Icon:PackIconMaterial></Grid></Border>
                    <UniformGrid Columns="2" Margin="0,18,0,0"><Border Background="#10283A" BorderBrush="#24445E" BorderThickness="1" CornerRadius="10" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Đối tượng" Foreground="#9FB3C8" FontSize="10"/><TextBlock Text="{Binding ObjectType}" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#10283A" BorderBrush="#24445E" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12"><StackPanel><TextBlock Text="Biển số" Foreground="#9FB3C8" FontSize="10"/><TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#10283A" BorderBrush="#24445E" BorderThickness="1" CornerRadius="10" Margin="0,0,8,8" Padding="12"><StackPanel><TextBlock Text="Camera" Foreground="#9FB3C8" FontSize="10"/><TextBlock Text="{Binding CameraId}" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#10283A" BorderBrush="#24445E" BorderThickness="1" CornerRadius="10" Margin="0,0,0,8" Padding="12"><StackPanel><TextBlock Text="Độ tin cậy" Foreground="#9FB3C8" FontSize="10"/><TextBlock Text="{Binding ConfidencePercent, StringFormat={}{0:F0}%}" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/><ProgressBar Value="{Binding ConfidencePercent}" Maximum="100" Height="5" Margin="0,7,0,0" Foreground="#2775FF" Background="#24445A" BorderThickness="0"/></StackPanel></Border></UniformGrid>
                    <Border Background="#10283A" BorderBrush="#24445E" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="Thời gian" Foreground="#9FB3C8" FontSize="10"/><TextBlock Text="{Binding EventTime}" Foreground="White" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        </Popup>
    </Grid>
</UserControl>
