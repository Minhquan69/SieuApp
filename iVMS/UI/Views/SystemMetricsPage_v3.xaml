       <RowDefinition Height="*"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions>
      <TextBlock Text="CPU" VerticalAlignment="Center" Foreground="#D7E6F4" FontSize="11"/><ProgressBar Style="{StaticResource ResourceProgress}" x:Name="CpuBar" Grid.Column="1" Maximum="100" Foreground="#347DFF" Background="#263B50" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="CpuBarText" Grid.Column="2" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
      <TextBlock Grid.Row="1" Text="Bộ nhớ" VerticalAlignment="Center" Foreground="#D7E6F4" FontSize="11"/><ProgressBar Style="{StaticResource ResourceProgress}" x:Name="MemoryBar" Grid.Row="1" Grid.Column="1" Maximum="100" Foreground="#20D37B" Background="#263B50" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="MemoryBarText" Grid.Row="1" Grid.Column="2" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
      <TextBlock Grid.Row="2" Text="Disk" VerticalAlignment="Center" Foreground="#D7E6F4" FontSize="11"/><ProgressBar Style="{StaticResource ResourceProgress}" x:Name="DiskBar" Grid.Row="2" Grid.Column="1" Maximum="100" Foreground="#FF7925" Background="#263B50" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="DiskBarText" Grid.Row="2" Grid.Column="2" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
      <TextBlock Grid.Row="3" Text="GPU" VerticalAlignment="Center" Foreground="#D7E6F4" FontSize="11"/><ProgressBar Style="{StaticResource ResourceProgress}" x:Name="GpuBar" Grid.Row="3" Grid.Column="1" Maximum="100" Foreground="#8B5CF6" Background="#263B50" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="GpuBarText" Grid.Row="3" Grid.Column="2" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
      <TextBlock Grid.Row="4" Text="Bộ nhớ GPU" VerticalAlignment="Center" Foreground="#D7E6F4" FontSize="11"/><ProgressBar Style="{StaticResource ResourceProgress}" x:Name="GpuMemoryBar" Grid.Row="4" Grid.Column="1" Maximum="100" Foreground="#347DFF" Background="#263B50" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock x:Name="GpuMemoryBarText" Grid.Row="4" Grid.Column="2" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" TextAlignment="Right"/>
     </Grid>
     <Border Grid.Row="3" Height="1" Background="#18354D" Margin="0,12,0,10"/>
     <Grid Grid.Row="4">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
       <Image Source="/images/nvidia_logo.png" Height="28" Width="Auto" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
       <TextBlock Text="NVIDIA GPU" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
      </StackPanel>
      <UniformGrid Grid.Row="1" Rows="1" Columns="4">
       <Border Background="#0A1C2B" BorderBrush="#18354D" BorderThickness="1" CornerRadius="5" Margin="0,0,6,0" Padding="10,7">
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Path Data="M1,3 H11 V11 H1 Z M11,5 H13 V9 H11 M3,11 V13 M5,11 V13 M7,11 V13 M3.3,5.3 A1.7,1.7 0 1 0 3.3,8.7 A1.7,1.7 0 1 0 3.3,5.3 M7,6 H9 M7,8 H9" Stroke="#6AA4FF" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
          <TextBlock Text="Thiết bị" Foreground="#6AA4FF" FontSize="10"/>
         </StackPanel>
         <TextBlock x:Name="GpuPanelCountText" Text="—" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
        </StackPanel>
       </Border>
       <Border Background="#0A1C2B" BorderBrush="#18354D" BorderThickness="1" CornerRadius="5" Margin="0,0,6,0" Padding="10,7">
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="M7,1 L2,7 H6 L5,12 L11,5 H7 Z" Stroke="#8B5CF6" StrokeThickness="1.3" Fill="Transparent"/></Viewbox>
          <TextBlock Text="Sử dụng" Foreground="#8B5CF6" FontSize="10"/>
         </StackPanel>
         <TextBlock x:Name="GpuPanelUtilizationText" Text="—" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
        </StackPanel>
       </Border>
       <Border Background="#0A1C2B" BorderBrush="#18354D" BorderThickness="1" CornerRadius="5" Margin="0,0,6,0" Padding="10,7">
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="M5,1 V7 A3,3 0 1 0 7,7 V1 A1,1 0 0 0 5,1" Stroke="#FF7925" StrokeThickness="1.3" Fill="Transparent"/></Viewbox>
          <TextBlock Text="Nhiệt độ" Foreground="#FF9B5E" FontSize="10"/>
         </StackPanel>
         <TextBlock x:Name="GpuPanelTemperatureText" Text="—" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
        </StackPanel>
       </Border>
       <Border Background="#0A1C2B" BorderBrush="#18354D" BorderThickness="1" CornerRadius="5" Margin="0" Padding="10,7">
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <Viewbox Width="13" Height="13" Margin="0,0,6,0"><Path Data="M1,3 H12 V10 H1 Z M3,5 H7 M3,8 H5" Stroke="#347DFF" StrokeThickness="1.3" Fill="Transparent"/></Viewbox>
          <TextBlock Text="VRAM" Foreground="#6AA4FF" FontSize="10"/>
         </StackPanel>
         <TextBlock x:Name="GpuPanelMemoryText" Text="—" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,4,0,0"/>
        </StackPanel>
       </Border>
      </UniformGrid>
     </Grid>
    </Grid>
   </Border>
    <ItemsControl x:Name="GpusList" Visibility="Collapsed" Grid.Column="1"/>
  </Grid>
  </StackPanel>
   <!-- Chart Tabs Container -->
   <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="8,0,8,8">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
     </Grid.RowDefinitions>
     <!-- Tab Bar -->
     <Border BorderBrush="#1C3850" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
       <RadioButton x:Name="TabOverview" Style="{StaticResource ChartTab}" GroupName="ChartTabs" Content="Tổng quan" IsChecked="True" Checked="ChartTab_Checked"/>
       <RadioButton x:Name="TabGpu" Style="{StaticResource ChartTab}" GroupName="ChartTabs" Content="GPU và VRAM" Checked="ChartTab_Checked"/>
       <RadioButton x:Name="TabDisk" Style="{StaticResource ChartTab}" GroupName="ChartTabs" Content="Disk" Checked="ChartTab_Checked"/>
       <RadioButton x:Name="TabNetwork" Style="{StaticResource ChartTab}" GroupName="ChartTabs" Content="Mạng" Checked="ChartTab_Checked"/>
      </StackPanel>
     </Border>
     <!-- Tab Content -->
     <!-- Tab: Tổng quan (CPU + Memory & CPU Temp) -->
     <Grid x:Name="TabContentOverview" Grid.Row="1" Margin="0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="#1C3850" BorderThickness="0,0,0,1"><TextBlock Text="CPU và bộ nhớ" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Width="11" Height="11" Fill="#347DFF"/><TextBlock Text="CPU" Foreground="#6AA4FF" FontSize="10" Margin="4,0,12,0"/><Ellipse Width="11" Height="11" Fill="#20D37B"/><TextBlock Text="Bộ nhớ" Foreground="#20D37B" FontSize="10" Margin="4,0,0,0"/></StackPanel>
        <Canvas Grid.Row="2" x:Name="CpuMemoryChart" Background="Transparent" Margin="12,0,12,10" SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave" Cursor="Cross"/>
       </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0,10,0,0">
       <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="#1C3850" BorderThickness="0,0,0,1"><TextBlock Text="Nhiệt CPU" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Width="11" Height="11" Fill="#FF7925"/><TextBlock Text="Nhiệt CPU" Foreground="#FF9B5E" FontSize="10" Margin="4,0,0,0"/></StackPanel>
        <Canvas Grid.Row="2" x:Name="CpuTemperatureChart" Background="Transparent" Margin="12,0,12,10" SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave" Cursor="Cross"/>
       </Grid>
      </Border>
     </Grid>
     <!-- Tab: GPU và VRAM -->
     <Border x:Name="TabContentGpu" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,0" Visibility="Collapsed">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border BorderBrush="#1C3850" BorderThickness="0,0,0,1"><TextBlock Text="GPU và VRAM" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border>
       <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Width="11" Height="11" Fill="#8B5CF6"/><TextBlock Text="GPU sử dụng" Foreground="#A678FF" FontSize="10" Margin="4,0,12,0"/><Ellipse Width="11" Height="11" Fill="#347DFF"/><TextBlock Text="Bộ nhớ GPU" Foreground="#6AA4FF" FontSize="10" Margin="4,0,0,0"/></StackPanel>
       <Canvas Grid.Row="2" x:Name="GpuChart" Background="Transparent" Margin="12,0,12,10" SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave" Cursor="Cross"/>
      </Grid>
     </Border>
     <!-- Tab: Disk -->
     <Border x:Name="TabContentDisk" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,0" Visibility="Collapsed">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border BorderBrush="#1C3850" BorderThickness="0,0,0,1"><TextBlock Text="Disk đọc / ghi" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/></Border>
       <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Width="11" Height="11" Fill="#347DFF"/><TextBlock Text="Đọc" Foreground="#6AA4FF" FontSize="10" Margin="4,0,12,0"/><Ellipse Width="11" Height="11" Fill="#FF7925"/><TextBlock Text="Ghi" Foreground="#FF9B5E" FontSize="10" Margin="4,0,0,0"/></StackPanel>
       <Canvas Grid.Row="2" x:Name="DiskChart" Background="Transparent" Margin="12,0,12,10" SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave" Cursor="Cross"/>
      </Grid>
     </Border>
     <!-- Tab: Mạng -->
     <Border x:Name="TabContentNetwork" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,10,0,0" Visibility="Collapsed">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border BorderBrush="#1C3850" BorderThickness="0,0,0,1">
        <StackPanel Margin="12,0" VerticalAlignment="Center"><TextBlock Text="Mạng RX / TX" Foreground="White" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="NetworkDetailText" Text="NIC vật lý" Foreground="#B3C7DD" FontSize="10" Margin="0,2,0,0"/></StackPanel>
       </Border>
       <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><Ellipse Width="11" Height="11" Fill="#20D37B"/><TextBlock Text="RX" Foreground="#20D37B" FontSize="10" Margin="4,0,12,0"/><Ellipse Width="11" Height="11" Fill="#FF7085"/><TextBlock Text="TX" Foreground="#FF9B5E" FontSize="10" Margin="4,0,0,0"/></StackPanel>
       <Canvas Grid.Row="2" x:Name="NetworkChart" Background="Transparent" Margin="12,0,12,10" SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave" Cursor="Cross"/>
      </Grid>
     </Border>
    </Grid>
   </Border>
  </Grid>
</UserControl>
