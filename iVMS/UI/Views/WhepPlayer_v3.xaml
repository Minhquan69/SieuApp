<UserControl x:Class="V3SClient.UI.Views.WhepPlayer_v3" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Background="{StaticResource VmsSurfaceBrush_v3}">
  <Grid ClipToBounds="True">
    <!-- The native D3D11 child must always be opaque.  An unset host/panel
         background can briefly expose the desktop while a stream is created
         or its native surface is resized. -->
    <wfi:WindowsFormsHost x:Name="VideoHost" Background="Black" ClipToBounds="True" />
    <Border x:Name="StatusPanel" Background="{StaticResource VmsSurfaceBrush_v3}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" Text="Select a camera to connect." HorizontalAlignment="Center" />
        <TextBlock x:Name="PipelineStateText" Foreground="{StaticResource VmsTextTertiaryBrush_v3}" Text="Pipeline: NULL" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <Border x:Name="ZoomIndicator" Width="34" Margin="0,8,8,8" HorizontalAlignment="Right" Background="#B8142638" CornerRadius="4" Padding="5" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="ZoomValueText" Text="100%" Foreground="White" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,5" />
        <ProgressBar x:Name="ZoomProgress" Width="8" Height="100" Minimum="1" Maximum="4" Value="1" Orientation="Vertical" Foreground="#3A82FF" Background="#40566A" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
