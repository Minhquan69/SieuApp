<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VmsBackgroundBrush_v3" Color="{StaticResource VmsBackgroundColor_v3}" />
    <SolidColorBrush x:Key="VmsSidebarBrush_v3" Color="{StaticResource VmsSidebarColor_v3}" />
    <SolidColorBrush x:Key="VmsHeaderBrush_v3" Color="{StaticResource VmsHeaderColor_v3}" />
    <SolidColorBrush x:Key="VmsSurfaceBrush_v3" Color="{StaticResource VmsSurfaceColor_v3}" />
    <SolidColorBrush x:Key="VmsSurface2Brush_v3" Color="{StaticResource VmsSurface2Color_v3}" />
    <SolidColorBrush x:Key="VmsSurface3Brush_v3" Color="{StaticResource VmsSurface3Color_v3}" />
    <SolidColorBrush x:Key="VmsElevatedBrush_v3" Color="{StaticResource VmsElevatedColor_v3}" />
    <SolidColorBrush x:Key="VmsBorderSubtleBrush_v3" Color="{StaticResource VmsBorderSubtleColor_v3}" />
    <SolidColorBrush x:Key="VmsBorderBrush_v3" Color="{StaticResource VmsBorderColor_v3}" />
    <SolidColorBrush x:Key="VmsBorderStrongBrush_v3" Color="{StaticResource VmsBorderStrongColor_v3}" />
    <SolidColorBrush x:Key="VmsTextPrimaryBrush_v3" Color="{StaticResource VmsTextPrimaryColor_v3}" />
    <SolidColorBrush x:Key="VmsTextSecondaryBrush_v3" Color="{StaticResource VmsTextSecondaryColor_v3}" />
    <SolidColorBrush x:Key="VmsTextTertiaryBrush_v3" Color="{StaticResource VmsTextTertiaryColor_v3}" />
    <SolidColorBrush x:Key="VmsTextDisabledBrush_v3" Color="{StaticResource VmsTextDisabledColor_v3}" />
    <SolidColorBrush x:Key="VmsTextInverseBrush_v3" Color="{StaticResource VmsTextInverseColor_v3}" />
    <SolidColorBrush x:Key="VmsPrimaryBrush_v3" Color="{StaticResource VmsPrimaryColor_v3}" />
    <SolidColorBrush x:Key="VmsPrimaryHoverBrush_v3" Color="{StaticResource VmsPrimaryHoverColor_v3}" />
    <SolidColorBrush x:Key="VmsPrimaryPressedBrush_v3" Color="{StaticResource VmsPrimaryPressedColor_v3}" />
    <SolidColorBrush x:Key="VmsFocusBrush_v3" Color="{StaticResource VmsFocusColor_v3}" />
    <SolidColorBrush x:Key="VmsSuccessBrush_v3" Color="{StaticResource VmsSuccessColor_v3}" />
    <SolidColorBrush x:Key="VmsWarningBrush_v3" Color="{StaticResource VmsWarningColor_v3}" />
    <SolidColorBrush x:Key="VmsErrorBrush_v3" Color="{StaticResource VmsErrorColor_v3}" />
    <SolidColorBrush x:Key="VmsInfoBrush_v3" Color="{StaticResource VmsInfoColor_v3}" />
    <SolidColorBrush x:Key="VmsOfflineBrush_v3" Color="{StaticResource VmsOfflineColor_v3}" />

    <SolidColorBrush x:Key="VmsPrimarySoftBrush_v3" Color="#242563EB" />
    <SolidColorBrush x:Key="VmsPrimarySofterBrush_v3" Color="#142563EB" />
    <SolidColorBrush x:Key="VmsPrimaryBorderBrush_v3" Color="#732563EB" />
    <SolidColorBrush x:Key="VmsSuccessSoftBrush_v3" Color="#2422C55E" />
    <SolidColorBrush x:Key="VmsWarningSoftBrush_v3" Color="#24F59E0B" />
    <SolidColorBrush x:Key="VmsErrorSoftBrush_v3" Color="#24EF4444" />

    <!-- Compact dark scrollbar used by the Live camera list.  Keep it as the
         V3 default so every migrated list has the same visual language. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="4" Height="4"
                                       Background="{StaticResource VmsBorderStrongBrush_v3}" />
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="Thumb" Property="Height" Value="4" />
                            <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
