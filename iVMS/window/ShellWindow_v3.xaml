<Window x:Class="V3SClient.window.ShellWindow_v3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:V3SClient.UI.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="iVista VMS"
        Width="1280" Height="760" MinWidth="320" MinHeight="200"
        ResizeMode="CanResize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource VmsBackgroundBrush_v3}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" Background="{StaticResource VmsBackgroundBrush_v3}" BorderBrush="#245174" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
        <views:ShellPage_v3 x:Name="ShellView" />
    </Border>
</Window>
