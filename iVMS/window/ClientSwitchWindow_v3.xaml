<Window x:Class="V3SClient.window.ClientSwitchWindow_v3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="720" Height="700" MinWidth="580" MinHeight="540"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" ShowInTaskbar="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/V3Migration/ClientSwitchWindow_v3.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{StaticResource VmsBackgroundBrush_v3}" BorderBrush="{StaticResource VmsBorderBrush_v3}"
            BorderThickness="1" CornerRadius="16" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource VmsPrimarySoftBrush_v3}" Margin="0,0,12,0">
                            <Icon:PackIconMaterial Kind="Domain" Width="22" Height="22" Foreground="{StaticResource VmsPrimaryBrush_v3}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Chọn Client" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="Chọn client trước khi vào hệ thống." Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="14" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="—" Click="Minimize_Click" Style="{StaticResource ClientSwitchButton_v3}" Width="34" Height="28" Padding="0" FontSize="14" Margin="0,0,6,0" />
                <Button Grid.Column="2" Content="×" Click="Close_Click" Style="{StaticResource ClientSwitchButton_v3}" Width="34" Height="28" Padding="0" FontSize="14" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,30,0,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Danh sách Client" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Command="{Binding ReloadCommand}" HorizontalAlignment="Right" Style="{StaticResource ClientSwitchButton_v3}" Padding="13,7"><StackPanel Orientation="Horizontal"><Icon:PackIconMaterial Kind="Refresh" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock Text="Tải lại"/></StackPanel></Button>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ClientSwitchListBoxItem_v3}" Background="Transparent" BorderThickness="0"
                         Margin="0,16,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="66">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Icon:PackIconMaterial Kind="Domain" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0"
                                                       Foreground="{StaticResource VmsPrimaryBrush_v3}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Code}" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="13" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{StaticResource VmsBorderBrush_v3}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                <Grid>
                    <TextBlock Text="Đang chọn: " Foreground="{StaticResource VmsTextSecondaryBrush_v3}" FontSize="13" VerticalAlignment="Center">
                        <Run Text="{Binding SelectedProfileName, Mode=OneWay}" Foreground="{StaticResource VmsTextPrimaryBrush_v3}" />
                    </TextBlock>
                    <Button Command="{Binding ConfirmCommand}" HorizontalAlignment="Right" Style="{StaticResource ClientSwitchPrimaryButton_v3}"><StackPanel Orientation="Horizontal"><Icon:PackIconMaterial Kind="CheckCircleOutline" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="Vào hệ thống"/></StackPanel></Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
