    <Style x:Key="ProfileList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
    <Style x:Key="ProfileListItem" TargetType="ListBoxItem"><Setter Property="Foreground" Value="#EDF5FF"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#071625" BorderBrush="#183653" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#0C2135"/><Setter TargetName="Card" Property="BorderBrush" Value="#285D90"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#102D4A"/><Setter TargetName="Card" Property="BorderBrush" Value="#2E67E8"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Page.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0B2441"/>
    <Border Grid.Column="1" Background="#061321"/>
    <Viewbox Grid.ColumnSpan="2" Stretch="Uniform" StretchDirection="Both">
  <Grid Width="1280" Height="760"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <!-- Keep the right panel dark while the entire left side uses the logo-blue. -->
    <Border Grid.Column="1" Background="#061321"/>
    <Border Grid.Column="0" BorderBrush="#143B61" BorderThickness="0,0,1,0"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#071827"/><GradientStop Color="#0B2441" Offset="1"/></LinearGradientBrush></Border.Background><Grid Margin="48"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image Source="/images/logo/ivista_logo.png" Width="156" Height="50" Stretch="Uniform" HorizontalAlignment="Left"/><Border Grid.Row="1" Background="#0B1E31" BorderBrush="#1A4975" BorderThickness="1" CornerRadius="18" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Height="460"><StackPanel><Border Background="#11336A" CornerRadius="14" Padding="12,6" HorizontalAlignment="Left"><TextBlock Text="◉  Nền tảng VMS trên web" Foreground="#B8D5FF" FontSize="12"/></Border><TextBlock Text="Giám sát video chuyên nghiệp&#x0a;mạnh mẽ và linh hoạt&#x0a;trên nền tảng web." Foreground="#EAF2FF" FontSize="33" FontWeight="SemiBold" LineHeight="41" Margin="0,32,0,0"/><TextBlock Text="Quản lý camera, theo dõi trạng thái hệ thống và giám sát tập trung." Foreground="#B7C7D9" FontSize="16" TextWrapping="Wrap" LineHeight="24" Margin="0,25,0,0"/><UniformGrid Columns="3" Margin="0,32,0,0"><Border Background="#122D48" BorderBrush="#1D456D" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,6,0"><StackPanel><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#2E67E8" FontSize="16"/><TextBlock Text="Bảo mật" Foreground="#C8D9EA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#122D48" BorderBrush="#1D456D" BorderThickness="1" CornerRadius="10" Padding="11,9" Margin="0,0,6,0"><StackPanel><TextBlock Text="&#xE95E;" FontFamily="Segoe MDL2 Assets" Foreground="#2E67E8" FontSize="16"/><TextBlock Text="Ổn định" Foreground="#C8D9EA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border><Border Background="#122D48" BorderBrush="#1D456D" BorderThickness="1" CornerRadius="10" Padding="11,9"><StackPanel><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#2E67E8" FontSize="16"/><TextBlock Text="Đa khu vực" Foreground="#C8D9EA" FontSize="11" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid></StackPanel></Border><TextBlock Grid.Row="2" Text="© 2026 iVista Tech" Foreground="#7C9DBA" FontSize="10"/></Grid></Border>
    <Grid Grid.Column="1" Margin="48"><StackPanel Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Chào mừng quay lại" Foreground="#F3F7FF" FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Đăng nhập để tiếp tục" Foreground="#B5C7DA" FontSize="16" Margin="0,8,0,34"/><Border Background="#3B1720" BorderBrush="#E65262" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,14"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ErrorMessage}" Foreground="#FFE7E9" TextWrapping="Wrap"/></Border>
      <Border Background="#0B1E31" BorderBrush="#1A4975" BorderThickness="1" CornerRadius="12" Padding="24"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProfileSelectionVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="Chọn profile làm việc" Foreground="#F3F7FF" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Chọn môi trường bạn muốn truy cập." Foreground="#9EB4CC" Margin="0,7,0,22"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Style="{StaticResource ProfileCombo}" ItemContainerStyle="{StaticResource ProfileItem}"/><TextBlock Text="{Binding SelectedProfile.Code}" Foreground="#819BB5" FontSize="12" Margin="3,9,0,22"/><Button Content="Vào hệ thống  →" Command="{Binding ContinueCommand}" Style="{StaticResource PrimaryButtonStyle_v3}" Height="48" FontSize="14"/></StackPanel></Border>
      <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsProfileSelectionVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Tài khoản" Foreground="#C2D3E5" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,9"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource VmsTextBoxStyle_v3}" Height="48" FontSize="14" Margin="0,0,0,18"/><TextBlock Text="Mật khẩu" Foreground="#C2D3E5" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,9"/><PasswordBox x:Name="PasswordInput" Height="48" Padding="14,10" FontSize="14" Background="#122A40" BorderBrush="#1B3B58" BorderThickness="1" Foreground="#EAF2FF" PasswordChanged="PasswordInput_OnPasswordChanged" Margin="0,0,0,23"/><Button Content="Đăng nhập  →" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButtonStyle_v3}" Height="48" FontSize="14"/></StackPanel><Border BorderBrush="#17344E" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,18,0,0"><TextBlock Text="Chưa có tài khoản? Liên hệ quản trị viên." Foreground="#B5C7DA" FontSize="11" HorizontalAlignment="Center"/></Border><TextBlock Text="{Binding StatusMessage}" Foreground="#9BC2FF" Margin="0,14,0,0" HorizontalAlignment="Center" FontSize="12"/></StackPanel></Grid>
    <!-- Profile selection is a dedicated view, matching the web layout rather than a dropdown. -->
    <Border Grid.ColumnSpan="2" Background="#061321" Padding="16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProfileSelectionVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border Background="#0B1E31" BorderBrush="#183B5B" BorderThickness="1" CornerRadius="16" Padding="32" Width="720" VerticalAlignment="Center" HorizontalAlignment="Center"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Chọn Profile" Foreground="#F3F7FF" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Chọn profile trước khi vào hệ thống." Foreground="#C0D4EB" FontSize="15" Margin="0,8,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Border Background="#0B1B2B" BorderBrush="#183653" BorderThickness="1" CornerRadius="8" Padding="12,7"><TextBlock Text="☼  Sáng" Foreground="#E7F2FF" FontSize="12"/></Border><Border Background="#0B1B2B" BorderBrush="#183653" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="8,0,0,0"><TextBlock Text="VI" Foreground="#E7F2FF" FontSize="12" FontWeight="SemiBold"/></Border><Border Background="#0B1B2B" BorderBrush="#183653" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="8,0,0,0"><TextBlock Text="↪ Đăng xuất" Foreground="#E7F2FF" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel></Grid><Grid Grid.Row="1" Margin="0,30,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Danh sách Profile" Foreground="#D9E8FA" FontSize="14" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Style="{StaticResource ProfileList}" ItemContainerStyle="{StaticResource ProfileListItem}" Margin="0,18,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F1;" FontFamily="Segoe MDL2 Assets" Foreground="#2E79EE" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" Foreground="#F0F6FF" FontSize="15" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding Code}" Foreground="#C0D4EB" FontSize="12" Margin="0,7,0,0"/><TextBlock Text="{Binding Description}" Foreground="#C0D4EB" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><Border Grid.Row="2" BorderBrush="#193852" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid><TextBlock Text="Vui lòng chọn 1 client" Foreground="#E1EDFA" VerticalAlignment="Center"/><Button Content="◉  Vào hệ thống" Command="{Binding ContinueCommand}" Style="{StaticResource PrimaryButtonStyle_v3}" Width="136" Height="42" HorizontalAlignment="Right"/></Grid></Border></Grid></Border></Border>
  </Grid>
    </Viewbox>
  </Grid>
