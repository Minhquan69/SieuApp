<Page x:Class="V3SClient.UI.Views.LoginPage_v3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Background="#061628"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">
    <Page.Resources>
        <Style x:Key="LoginLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F6FC"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="LoginField" TargetType="TextBox" BasedOn="{StaticResource VmsTextBoxStyle_v3}"><Setter Property="Height" Value="48"/><Setter Property="FontSize" Value="20"/><Setter Property="Background" Value="#B311263D"/><Setter Property="BorderBrush" Value="#496E97"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Padding" Value="14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style x:Key="LoginCardChrome" TargetType="Border"><Setter Property="Background" Value="#E6081528"/><Setter Property="BorderBrush" Value="#B950D8FF"/><Setter Property="BorderThickness" Value="1.5"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#F070E5FF"/><Setter Property="Background" Value="#ED0A1A31"/></Trigger></Style.Triggers></Style>
        <Style x:Key="LoginInputFrame" TargetType="Border"><Setter Property="Background" Value="#A7061324"/><Setter Property="BorderBrush" Value="#4A52667D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#8B55CBFF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#FF39C6FF"/><Setter Property="Background" Value="#C9091A31"/></Trigger></Style.Triggers></Style>
        <Style x:Key="LoginPasswordField" TargetType="PasswordBox"><Setter Property="Height" Value="56"/><Setter Property="Padding" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="20"/><Setter Property="Background" Value="#A7061324"/><Setter Property="BorderBrush" Value="#4A52667D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#D9E5F1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="48,0,42,0" VerticalContentAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ForgotLink" TargetType="TextBlock"><Setter Property="Foreground" Value="#7DD3FC"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#B9EAFF"/><Setter Property="TextDecorations" Value="Underline"/></Trigger></Style.Triggers></Style>
        <Style x:Key="ServerPulse" TargetType="Ellipse"><Setter Property="Fill" Value="#22C55E"/><Style.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True"><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.9"/></Storyboard></BeginStoryboard></EventTrigger></Style.Triggers></Style>
        <Style x:Key="LoginButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle_v3}">
            <Setter Property="Height" Value="62"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#129CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.72"/></Setter.Value></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#10355D"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><Grid ClipToBounds="True"><Rectangle x:Name="Highlight" Fill="#66D9F6FF" Opacity="0"/><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/><Border x:Name="AmberFlare" Height="3" VerticalAlignment="Bottom" Opacity="0.5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="Transparent"/><GradientStop Color="#FFFF8A2A" Offset="0.58"/><GradientStop Color="#FFFFD09B" Offset="0.72"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect Color="#FFFF7A18" BlurRadius="9" ShadowDepth="0" Opacity="0.95"/></Border.Effect></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.16"/><Setter TargetName="AmberFlare" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.48"/><Setter TargetName="AmberFlare" Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoginReady}" Value="True"><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2563EB"/><GradientStop Color="#0EA5E9" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoginRememberCheckBox" TargetType="CheckBox"><Setter Property="Foreground" Value="#C7D2DE"/><Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="17" Height="17" CornerRadius="3" Background="#081827" BorderBrush="#66829E" BorderThickness="1" Margin="0,0,8,0"><Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#65D4FF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#176DE4"/><Setter TargetName="Box" Property="BorderBrush" Value="#65D4FF"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ProfileItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="20"/><Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="4" Margin="4,2"><TextBlock Text="{Binding Name}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#1D4164"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#245A86"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProfileCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EAF2FF"/><Setter Property="Background" Value="#B311263D"/><Setter Property="BorderBrush" Value="#496E97"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="20"/><Setter Property="Height" Value="56"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleRoot" Property="BorderBrush" Value="#60CAFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><Grid><TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="16,0,46,0" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#60CAFF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/></Grid></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}"><Border Background="#0F263D" BorderBrush="#4F7FA8" BorderThickness="1" CornerRadius="5" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="2"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LoginBackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LoginBackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.65"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="MarketingPanel" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.08"/>
                    <DoubleAnimation Storyboard.TargetName="MarketingTranslate" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.45" BeginTime="0:0:0.08"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5" BeginTime="0:0:0.14"/>
                    <DoubleAnimation Storyboard.TargetName="LoginCardTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.5" BeginTime="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LoginCard" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" From="0.36" To="0.78" Duration="0:0:2.2" BeginTime="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="LoginSubmitButton" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" From="0.5" To="0.9" Duration="0:0:1.35" BeginTime="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid ClipToBounds="True">
        <Image x:Name="LoginBackgroundImage" Source="pack://application:,,,/Assets/Images/ivms-login-background-3d-1920x1080.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" CacheMode="BitmapCache"><Image.RenderTransform><ScaleTransform x:Name="LoginBackgroundScale" ScaleX="1.02" ScaleY="1.02"/></Image.RenderTransform></Image>
        <Rectangle IsHitTestVisible="False"><Rectangle.Fill><RadialGradientBrush Center="0.53,0.46" GradientOrigin="0.53,0.46" RadiusX="0.88" RadiusY="0.9"><GradientStop Color="#10020B18" Offset="0.28"/><GradientStop Color="#B805111F" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
        <!-- A single 1920 × 1080 design canvas keeps the login card and the
             background composition in the same proportions at every desktop
             zoom level and when the window is maximized. -->
        <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="1920" Height="1080">
        <Grid x:Name="LoginLayout" Margin="96,54,76,44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="61*"/><ColumnDefinition Width="39*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <StackPanel x:Name="MarketingPanel" VerticalAlignment="Top" MaxWidth="680" Margin="18,10,78,0" Opacity="0" RenderTransformOrigin="0.5,0.5"><StackPanel.Resources><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/></Style></StackPanel.Resources><StackPanel.RenderTransform><TranslateTransform x:Name="MarketingTranslate" Y="14"/></StackPanel.RenderTransform>
                <Image Source="/images/logo/ivista_logo.png" Width="246" Height="82" Stretch="Uniform" HorizontalAlignment="Left"/>
                <TextBlock Text="iVMS" Foreground="White" FontSize="42" FontWeight="ExtraBold" Margin="0,8,0,0"/>
                <TextBlock Text="NỀN TẢNG QUẢN LÝ VIDEO THÔNG MINH" Foreground="White" FontSize="20" FontWeight="ExtraBold" Margin="0,20,0,0"/>
                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="#E8F0FA">
                    <Run Text="Giám sát tập trung"/><Run Text="  •  " Foreground="#2F80ED"/><Run Text="Phân tích AI"/><Run Text="  •  " Foreground="#2F80ED"/><Run Text="Vận hành an toàn"/>
                </TextBlock>
            </StackPanel>

            <Border x:Name="LoginCard" Grid.Column="1" MinWidth="440" MaxWidth="650" MinHeight="770" MaxHeight="920" Width="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="30,20,8,20" Style="{StaticResource LoginCardChrome}" CornerRadius="28" Padding="56,56" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.Effect><DropShadowEffect Color="#129CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.42"/></Border.Effect><Border.RenderTransform><TranslateTransform x:Name="LoginCardTranslate" X="26"/></Border.RenderTransform>
                <StackPanel>
                    <Border x:Name="SecurityShield" Width="62" Height="62" CornerRadius="31" Background="#2B0E3C70" HorizontalAlignment="Center"><Icon:PackIconMaterial Kind="ShieldCheckOutline" Width="35" Height="35" Foreground="#53CFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" Foreground="#FFFFFF" FontSize="40" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,16,0,5"/>
                    <TextBlock Text="Truy cập trung tâm giám sát và điều hành" Foreground="#D1E2F1" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Border Background="#4D5B1420" BorderBrush="#D95B2430" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding ErrorMessage}" Foreground="#FFE5E8" TextWrapping="Wrap" FontSize="18"/></Border>
                    <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsProfileSelectionVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource LoginLabel}" FontSize="17"/>
                        <Grid Height="56" Margin="0,0,0,17">
                            <Border Style="{StaticResource LoginInputFrame}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Icon:PackIconMaterial Kind="AccountOutline" Width="21" Height="21" Foreground="#60CAFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="Nhập tên đăng nhập" Foreground="#A9BED1" FontSize="20" FontStyle="Italic" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,14,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Username, TargetNullValue=''}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBox x:Name="UsernameInput" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" TextChanged="UsernameInput_OnTextChanged" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#FFFFFF" FontSize="20" Padding="0,0,14,0" VerticalContentAlignment="Center"><TextBox.Style><Style TargetType="TextBox"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Mật khẩu" Style="{StaticResource LoginLabel}" FontSize="17"/><PasswordBox x:Name="PasswordInput" Style="{StaticResource LoginPasswordField}" PasswordChanged="PasswordInput_OnPasswordChanged" Margin="0,0,0,4"/>
                        <TextBlock Text="Quên mật khẩu? Liên hệ quản trị viên" Style="{StaticResource ForgotLink}" FontSize="16" HorizontalAlignment="Right" Margin="0,5,0,19"/>
                        <Button x:Name="LoginSubmitButton" Click="LoginSubmitButton_Click" IsEnabled="False" Style="{StaticResource LoginButton}">
                            <Grid>
                                <Icon:PackIconMaterial x:Name="LoginSubmitArrow" Kind="ArrowRight" Width="25" Height="25" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,22,0"/>
                                <TextBlock x:Name="LoginSubmitText" Text="ĐĂNG NHẬP" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel x:Name="LoginBusyIndicator" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5" Visibility="Collapsed"><Viewbox Width="22" Height="22" Margin="0,0,10,0"><Canvas Width="22" Height="22"><Path Data="M 11,2 A 9,9 0 1 1 2,11" Stroke="White" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.RenderTransform><RotateTransform CenterX="11" CenterY="11"/></Path.RenderTransform><Path.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)" By="360" Duration="0:0:0.75"/></Storyboard></BeginStoryboard></EventTrigger></Path.Triggers></Path></Canvas></Viewbox><TextBlock Text="ĐANG ĐĂNG NHẬP..." FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/></StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,24,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProfileSelectionVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="CHỌN PROFILE LÀM VIỆC" Style="{StaticResource LoginLabel}" FontSize="20"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" Style="{StaticResource ProfileCombo}" ItemContainerStyle="{StaticResource ProfileItem}"/>
                        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="QUAY LẠI" Command="{Binding BackToLoginCommand}" Style="{StaticResource SecondaryButtonStyle_v3}" Height="56" FontSize="20" FontWeight="Bold" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="VÀO HỆ THỐNG" Command="{Binding ContinueCommand}" Style="{StaticResource LoginButton}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <Border BorderBrush="#35526F" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="8" Height="8" Style="{StaticResource ServerPulse}" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Máy chủ: Đã kết nối" Foreground="#BFE9CF" FontSize="16"/></StackPanel></Border>
                </StackPanel>
            </Border>
            <Grid Grid.Row="0" Grid.Column="1" Width="{Binding ActualWidth, ElementName=LoginCard}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,50" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Icon:PackIconMaterial Kind="CogOutline" Width="16" Height="16" Foreground="#9FB5C9" Margin="0,0,8,0"/>
                    <TextBlock Text="Phiên bản 2.6.0" Foreground="#B7C7D8" FontSize="24" VerticalAlignment="Center"/>
                    <Border Width="1" Height="18" Background="#36506B" Margin="22,0" VerticalAlignment="Center"/>
                    <TextBlock Text="© 2026 iVista Tech" Foreground="#B7C7D8" FontSize="34" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
        </Viewbox>
    </Grid>
</Page>
