<Page x:Class="V3SClient.UI.Views.VLivePosition"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:converters="clr-namespace:V3SClient.UI.Converters"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d" Title="Vị trí trực tuyến" Background="#1A1A1A"
      SizeChanged="VLivePosition_SizeChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="SidebarColumn" Width="350" />
        </Grid.ColumnDefinitions>
        <wv2:WebView2 x:Name="mapWebView" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Border x:Name="CameraSidebar" Grid.Column="1" Background="#202329" BorderBrush="#343942" BorderThickness="1,0,0,0" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DANH SÁCH CAMERA" Foreground="#F4F6F8" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="E-map" Foreground="#9BA3AF" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Content="‹" Width="28" Height="28" HorizontalAlignment="Right" Click="ToggleSidebar_Click"
                            Background="#30353D" Foreground="#DDE2E8" BorderThickness="0" FontSize="20" ToolTip="Thu gọn" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#2A3038" CornerRadius="6" Margin="0,0,5,0" Padding="8">
                                <StackPanel><TextBlock Text="CAMERA" Foreground="#9BA3AF" FontSize="10"/><TextBlock Text="{Binding Sidebar.CameraCount, Mode=OneWay}" Foreground="#F4F6F8" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="#2A3038" CornerRadius="6" Margin="3,0" Padding="8">
                                <StackPanel><TextBlock Text="TRỰC TUYẾN" Foreground="#9BA3AF" FontSize="10"/><TextBlock Text="{Binding Sidebar.OnlineCameraCount, Mode=OneWay}" Foreground="#55D68A" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#2A3038" CornerRadius="6" Margin="5,0,0,0" Padding="8">
                                <StackPanel><TextBlock Text="NHÓM" Foreground="#9BA3AF" FontSize="10"/><TextBlock Text="{Binding Sidebar.GroupCount, Mode=OneWay}" Foreground="#F4F6F8" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                        </Grid>
                        <TextBox Text="{Binding Sidebar.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="10,7" Background="#2A3038" Foreground="#F4F6F8" BorderBrush="#454C57" BorderThickness="1" ToolTip="Tìm camera hoặc nhóm" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                            <Button Content="Tất cả" Click="SidebarAllFilter_Click" Padding="12,5" Margin="0,0,6,0" Background="#3B82F6" Foreground="White" BorderThickness="0" />
                            <Button Content="AI" Click="SidebarAiFilter_Click" Padding="12,5" Background="#30353D" Foreground="#DDE2E8" BorderThickness="0" />
                            <Button Content="Mở hết" Click="SidebarExpandAll_Click" Padding="8,5" Margin="12,0,0,0" Background="Transparent" Foreground="#9CC4FF" BorderThickness="0" />
                            <Button Content="Đóng" Click="SidebarCollapseAll_Click" Padding="6,5" Background="Transparent" Foreground="#9CC4FF" BorderThickness="0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Sidebar.CameraGroups}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Foreground="#F4F6F8" Margin="0,0,0,5">
                                    <Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CameraCount, StringFormat=  ({0})}" Foreground="#9BA3AF" Margin="5,0,0,0"/></StackPanel></Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Cameras}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Margin="0,2" Background="#292E36">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center" Fill="#77808C" Margin="0,0,5,0" />
                                                <StackPanel Grid.Column="1" Margin="5,7,4,7">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F4F6F8" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Status}" Foreground="#9BA3AF" FontSize="10" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="AI" Foreground="#8AB4FF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="3">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsAiCamera}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="⌖" Tag="{Binding}" Click="SidebarCamera_Click" Width="25" Background="Transparent" Foreground="#B9C8DA" BorderThickness="0" ToolTip="Tập trung trên bản đồ" />
                                                    <Button Content="Live" Tag="{Binding}" Click="SidebarLive_Click" Padding="5,3" Background="#2563EB" Foreground="White" BorderThickness="0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Button x:Name="SidebarOpenButton" Grid.Column="0" Content="›" Width="32" Height="48" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ToggleSidebar_Click" Visibility="Collapsed" Background="#202329" Foreground="White" BorderThickness="0" FontSize="24" ToolTip="Mở danh sách camera" />
    </Grid>
</Page>
