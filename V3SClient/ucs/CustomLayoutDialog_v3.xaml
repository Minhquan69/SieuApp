<Window x:Class="V3SClient.ucs.CustomLayoutDialog_v3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="650" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="#081827" Foreground="#E7F0FA">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/><Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="#E7F0FA"/><Setter Property="Background" Value="#17324A"/>
            <Setter Property="BorderBrush" Value="#285276"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="#204669"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}"><Setter Property="Background" Value="#2864E8"/><Setter Property="BorderBrush" Value="#3B82F6"/></Style>
        <Style x:Key="NumberInput" TargetType="TextBox"><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#F4F8FC"/><Setter Property="Background" Value="#102940"/><Setter Property="BorderBrush" Value="#285276"/><Setter Property="BorderThickness" Value="1"/></Style>
    </Window.Resources>
    <Border Margin="4" Padding="22" CornerRadius="8" Background="#081827" BorderBrush="#245174" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="B&#x1ED1; c&#x1EE5;c t&#xF9;y ch&#x1EC9;nh" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="T&#x1EA1;o l&#x1B0;&#x1EDB;i, k&#xE9;o ch&#x1ECD;n v&#xF9;ng h&#xEC;nh ch&#x1EEF; nh&#x1EAD;t r&#x1ED3;i g&#x1ED9;p th&#xE0;nh m&#x1ED9;t khung h&#xEC;nh." Foreground="#9DB2C8" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="&#xD7;" Width="36" MinWidth="36" Padding="0" Click="CloseButton_Click" Style="{StaticResource DialogButton}"/></Grid>
            <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="S&#x1ED1; h&#xE0;ng" Foreground="#C5D4E3" Margin="0,0,0,6"/><TextBox x:Name="RowsInput" Style="{StaticResource NumberInput}" PreviewTextInput="IntegerInput_PreviewTextInput"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="S&#x1ED1; c&#x1ED9;t" Foreground="#C5D4E3" Margin="0,0,0,6"/><TextBox x:Name="ColumnsInput" Style="{StaticResource NumberInput}" PreviewTextInput="IntegerInput_PreviewTextInput"/></StackPanel><Button Grid.Column="4" VerticalAlignment="Bottom" Content="T&#x1EA1;o l&#x1EA1;i l&#x1B0;&#x1EDB;i" Click="CreateGridButton_Click" Style="{StaticResource DialogButton}"/></Grid>
            <Grid Grid.Row="2" Margin="0,14,0,10"><StackPanel Orientation="Horizontal"><Button Content="G&#x1ED9;p v&#xF9;ng ch&#x1ECD;n" Click="MergeButton_Click" Style="{StaticResource PrimaryDialogButton}"/><Button Content="T&#xE1;ch &#xF4;" Click="UnmergeButton_Click" Style="{StaticResource DialogButton}" Margin="8,2,2,2"/></StackPanel><TextBlock Text="Ch&#x1EC9; h&#x1ED7; tr&#x1EE3; v&#xF9;ng vu&#xF4;ng ho&#x1EB7;c ch&#x1EEF; nh&#x1EAD;t" Foreground="#9DB2C8" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
            <Border Grid.Row="3" Background="#07131F" BorderBrush="#285276" BorderThickness="1" Padding="8"><Grid x:Name="PreviewGrid" ClipToBounds="True"/></Border>
            <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="0,9,0,0" Foreground="#FF8291" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Grid Grid.Row="5" Margin="0,16,0,0"><TextBlock x:Name="LayoutSummaryText" VerticalAlignment="Center" Foreground="#A9BED2"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="H&#x1EE7;y" IsCancel="True" Style="{StaticResource DialogButton}"/><Button Content="&#xC1;p d&#x1EE5;ng" IsDefault="True" Click="ApplyButton_Click" Style="{StaticResource PrimaryDialogButton}" Margin="8,2,2,2"/></StackPanel></Grid>
        </Grid>
    </Border>
</Window>
